<div class="user-page-header {{ centered|default(false) ? 'is-centered' : '' }}">
    <div class="user-page-header__content">
        {% if eyebrow is defined and eyebrow %}
            <p class="user-page-header__eyebrow mb-2">{{ eyebrow }}</p>
        {% endif %}

        <h1 class="user-page-header__title mb-2">
            {% if icon is defined and icon %}
                <i class="{{ icon }} me-2" aria-hidden="true"></i>
            {% endif %}
            {{ title }}
        </h1>

        {% if subtitle is defined and subtitle %}
            <p class="user-page-header__subtitle mb-0">
                {{ subtitle }}
            </p>
        {% endif %}
    </div>

    {% if actions is defined and actions %}
        <div class="user-page-header__actions">
            {{ actions|raw }}
        </div>
    {% endif %}
</div>