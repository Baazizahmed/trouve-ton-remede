<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">

        <title>
            {% block title %}{% endblock %}
            - Espace utilisateur | Oumi
        </title>
        <meta name="description" content="{% block description %}{% endblock %}">
        <meta name="robots" content="index,follow">
        <meta name="author" content="Oumi">
        <meta name="theme-color" content="#456f43">

        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">

        <link rel="icon" type="image/png" href="/favicon-96x96.png">

        <link rel="stylesheet"
              href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css"
              crossorigin="anonymous"
              referrerpolicy="no-referrer"/>

        {% block stylesheets %}
            {{ encore_entry_link_tags('app') }}
        {% endblock %}

        {% block javascripts %}
            {{ encore_entry_script_tags('app') }}
        {% endblock %}
    </head>

    <body class="body-user">
        {% set pathClient = app.request.pathInfo %}
        {% set cartCount = cartCounter.getItemCount() %}

        <nav class="navbar navbar-expand-lg user-topbar">
            <div class="container user-topbar__inner">
                <a class="navbar-brand user-topbar__brand" href="{{ path('app_user_home') }}">
                    <span class="user-topbar__brand-icon">
                        <i class="fa-solid fa-leaf" aria-hidden="true"></i>
                    </span>
                    <span class="user-topbar__brand-text">
                        TrouveTonRemede
                    </span>
                </a>

                <button class="navbar-toggler user-topbar__toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#userNavbarNav"
                        aria-controls="userNavbarNav"
                        aria-expanded="false"
                        aria-label="Ouvrir la navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse user-topbar__collapse" id="userNavbarNav">
                    <ul class="navbar-nav user-topbar__nav">
                        <li class="nav-item">
                            <a class="nav-link {{ pathClient == path('app_user_home') ? 'active' : '' }}"
                               {% if pathClient == path('app_user_home') %}aria-current="page"{% endif %}
                               href="{{ path('app_user_home') }}">
                                <i class="fa-solid fa-house me-2" aria-hidden="true"></i>
                                Accueil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link {{ pathClient == path('app_user_profile_index') ? 'active' : '' }}"
                               {% if pathClient == path('app_user_profile_index') %}aria-current="page"{% endif %}
                               href="{{ path('app_user_profile_index') }}">
                                <i class="fa-solid fa-user me-2" aria-hidden="true"></i>
                                Mon profil
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link {{ pathClient == path('app_cart_index') ? 'active' : '' }}"
                               {% if pathClient == path('app_cart_index') %}aria-current="page"{% endif %}
                               href="{{ path('app_cart_index') }}">
                                <i class="fa-solid fa-basket-shopping me-2" aria-hidden="true"></i>
                                Panier
                                {% if cartCount > 0 %}
                                    <span class="user-topbar__count-badge">{{ cartCount }}</span>
                                {% endif %}
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link {{ pathClient == path('app_order_index') ? 'active' : '' }}"
                               {% if pathClient == path('app_order_index') %}aria-current="page"{% endif %}
                               href="{{ path('app_order_index') }}">
                                <i class="fa-solid fa-box me-2" aria-hidden="true"></i>
                                Mes commandes
                            </a>
                        </li>
                    </ul>

                    <div class="user-topbar__actions">
                        {% if app.user and is_granted('ROLE_ADMIN') %}
                            <a class="btn btn-sm user-topbar__btn user-topbar__btn--soft"
                               href="{{ path('app_admin_home') }}">
                                <i class="fa-solid fa-shield-halved me-2" aria-hidden="true"></i>
                                Admin
                            </a>
                        {% endif %}

                        <a class="btn btn-sm user-topbar__btn user-topbar__btn--ghost"
                           href="{{ path('app_visitor_welcome') }}">
                            <i class="fa-solid fa-arrow-left me-2" aria-hidden="true"></i>
                            Retour au site
                        </a>

                        <a class="btn btn-sm user-topbar__btn user-topbar__btn--danger"
                           href="{{ path('app_logout') }}">
                            <i class="fa-solid fa-right-from-bracket me-2" aria-hidden="true"></i>
                            Déconnexion
                        </a>
                    </div>
                </div>
            </div>
        </nav>

        <main class="user-layout__main py-4">
            {% block main %}{% endblock %}
        </main>

        <footer class="user-footer">
            <div class="container user-footer__inner text-center">
                <p class="user-footer__title mb-1">
                    Espace utilisateur TrouveTonRemede
                </p>

                <small class="user-footer__meta">
                    © {{ "now"|date("Y") }} — Herboristerie & boutique bien-être
                </small>
            </div>
        </footer>
    </body>
</html>