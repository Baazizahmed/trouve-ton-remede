{% extends 'themes/base_admin.html.twig' %}

{% block title %}Gestion des Commandes{% endblock %}
{% block description %}Gestion des Commandes{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Suivi des commandes</span>
{% endblock %}

{% block main %}
<div class="container-fluid mt-4 admin-orders-page">

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Commandes',
        title: 'Gestion des Commandes',
        subtitle: 'Suivi des commandes clients et de leur statut.'
    } %}

    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm border-0" role="alert">
            {{ message }}
        </div>
    {% endfor %}

    {% set tableContent %}
        <div class="table-responsive d-none d-lg-block">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Client</th>
                        <th>Date</th>
                        <th>Total TTC</th>
                        <th>Statut</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for order in orders %}
                        {% set statusVariant =
                            order.status == 'PENDING' ? 'pending' :
                            (order.status == 'PAID' ? 'paid' :
                            (order.status == 'SHIPPED' ? 'shipped' :
                            'cancelled'))
                        %}

                        {% set statusLabel =
                            order.status == 'PENDING' ? 'En attente' :
                            (order.status == 'PAID' ? 'Payée' :
                            (order.status == 'SHIPPED' ? 'Expédiée' :
                            (order.status == 'CANCELLED' ? 'Annulée' : order.status)))
                        %}

                        <tr>
                            <td class="fw-semibold text-nowrap">
                                <span class="admin-order-number">#{{ order.id }}</span>
                            </td>

                            <td>
                                <div class="admin-order-customer">
                                    <span class="admin-order-customer__email">{{ order.user.email }}</span>
                                </div>
                            </td>

                            <td class="text-nowrap">
                                <div class="admin-order-date">
                                    {{ order.createdAt|date('d/m/Y') }}
                                    <span class="admin-order-date__time">{{ order.createdAt|date('H:i') }}</span>
                                </div>
                            </td>

                            <td class="text-nowrap">
                                <span class="badge rounded-pill admin-order-total-badge">
                                    {{ order.totalTtc|number_format(2, ',', ' ') }} €
                                </span>
                            </td>

                            <td>
                                <span class="badge rounded-pill admin-order-status admin-order-status--{{ statusVariant }}">
                                    {{ statusLabel }}
                                </span>
                            </td>

                            <td class="text-end">
                                <a href="{{ path('app_admin_order_show', {'id': order.id}) }}"
                                   class="btn btn-sm admin-action-btn admin-action-btn--view">
                                    <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                    <span>Voir</span>
                                </a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="d-lg-none p-3 admin-orders-mobile-list">
            {% for order in orders %}
                {% set statusVariant =
                    order.status == 'PENDING' ? 'pending' :
                    (order.status == 'PAID' ? 'paid' :
                    (order.status == 'SHIPPED' ? 'shipped' :
                    'cancelled'))
                %}

                {% set statusLabel =
                    order.status == 'PENDING' ? 'En attente' :
                    (order.status == 'PAID' ? 'Payée' :
                    (order.status == 'SHIPPED' ? 'Expédiée' :
                    (order.status == 'CANCELLED' ? 'Annulée' : order.status)))
                %}

                <article class="admin-orders-card">
                    <div class="admin-orders-card__body">
                        <div class="admin-orders-card__top">
                            <div>
                                <div class="admin-orders-card__number">Commande #{{ order.id }}</div>
                                <div class="admin-orders-card__date">{{ order.createdAt|date('d/m/Y H:i') }}</div>
                            </div>

                            <span class="badge rounded-pill admin-order-status admin-order-status--{{ statusVariant }}">
                                {{ statusLabel }}
                            </span>
                        </div>

                        <div class="admin-orders-card__row">
                            <span class="admin-orders-card__label">Client</span>
                            <span class="admin-orders-card__value text-break">{{ order.user.email }}</span>
                        </div>

                        <div class="admin-orders-card__row">
                            <span class="admin-orders-card__label">Total TTC</span>
                            <span class="admin-orders-card__value">
                                <span class="badge rounded-pill admin-order-total-badge">
                                    {{ order.totalTtc|number_format(2, ',', ' ') }} €
                                </span>
                            </span>
                        </div>

                        <div class="mt-3">
                            <a href="{{ path('app_admin_order_show', {'id': order.id}) }}"
                               class="btn admin-action-btn admin-action-btn--view w-100 justify-content-center">
                                <i class="fa-solid fa-eye" aria-hidden="true"></i>
                                <span>Voir la commande</span>
                            </a>
                        </div>
                    </div>
                </article>
            {% endfor %}
        </div>
    {% endset %}

    {% set emptyState %}
        <div class="admin-empty-state">
            <div class="admin-empty-state__icon">
                <i class="fa-solid fa-basket-shopping" aria-hidden="true"></i>
            </div>

            <h3 class="admin-empty-state__title">Aucune commande pour le moment</h3>

            <p class="admin-empty-state__text">
                Les commandes validées par les clients apparaîtront ici avec leur statut et leur total.
            </p>
        </div>
    {% endset %}

    <div class="mt-4">
        {% include 'components/admin/table_card.html.twig' with {
            title: 'Liste des commandes',
            subtitle: 'Consultez les commandes récentes et accédez rapidement à leur détail.',
            actions: null,
            table: orders|length ? tableContent : null,
            empty_state: orders|length ? null : emptyState,
            body_class: orders|length ? 'is-flush' : ''
        } %}
    </div>
</div>
{% endblock %}