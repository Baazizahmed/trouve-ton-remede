{% extends 'themes/base_admin.html.twig' %}

{% block title %}Gestion des Commandes{% endblock %}

{% block main %}
<div class="container-fluid mt-4 admin-orders-page">
    <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-2 mb-4">
        <div>
            <h1 class="mb-1">Gestion des Commandes</h1>
            <p class="text-muted mb-0">Suivi des commandes clients et de leur statut.</p>
        </div>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success shadow-sm border-0" role="alert">
            {{ message }}
        </div>
    {% endfor %}

    {# Desktop seulement #}
    <div class="card shadow-sm border-0 d-none d-lg-block">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>N°</th>
                            <th>Client</th>
                            <th>Date</th>
                            <th>Total TTC</th>
                            <th>Statut</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for order in orders %}
                            {% set statusClass =
                                order.status == 'PENDING' ? 'bg-warning text-dark' :
                                (order.status == 'PAID' ? 'bg-success text-white' :
                                (order.status == 'SHIPPED' ? 'bg-info text-dark' :
                                'bg-danger text-white'))
                            %}

                            {% set statusLabel =
                                order.status == 'PENDING' ? 'En attente' :
                                (order.status == 'PAID' ? 'Payée' :
                                (order.status == 'SHIPPED' ? 'Expédiée' :
                                order.status))
                            %}

                            <tr>
                                <td class="fw-semibold text-nowrap">#{{ order.id }}</td>
                                <td class="text-break">{{ order.user.email }}</td>
                                <td class="text-nowrap">{{ order.createdAt|date('d/m/Y H:i') }}</td>
                                <td class="fw-semibold text-nowrap">{{ order.totalTtc|number_format(2, ',', ' ') }} €</td>
                                <td>
                                    <span class="badge rounded-pill px-3 py-2 {{ statusClass }}">
                                        {{ statusLabel }}
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('app_admin_order_show', {'id': order.id}) }}"
                                       class="btn btn-sm btn-primary">
                                        Voir
                                    </a>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    Aucune commande.
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    {# Mobile + tablette #}
    <div class="d-lg-none">
        {% for order in orders %}
            {% set statusClass =
                order.status == 'PENDING' ? 'bg-warning text-dark' :
                (order.status == 'PAID' ? 'bg-success text-white' :
                (order.status == 'SHIPPED' ? 'bg-info text-dark' :
                'bg-danger text-white'))
            %}

            {% set statusLabel =
                order.status == 'PENDING' ? 'En attente' :
                (order.status == 'PAID' ? 'Payée' :
                (order.status == 'SHIPPED' ? 'Expédiée' :
                order.status))
            %}

            <div class="card shadow-sm border-0 mb-3 admin-orders-card">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                        <div>
                            <div class="admin-orders-card__number">Commande #{{ order.id }}</div>
                            <div class="admin-orders-card__date">{{ order.createdAt|date('d/m/Y H:i') }}</div>
                        </div>

                        <span class="badge rounded-pill px-3 py-2 {{ statusClass }}">
                            {{ statusLabel }}
                        </span>
                    </div>

                    <div class="admin-orders-card__row">
                        <span class="admin-orders-card__label">Client</span>
                        <span class="admin-orders-card__value text-break">{{ order.user.email }}</span>
                    </div>

                    <div class="admin-orders-card__row">
                        <span class="admin-orders-card__label">Total TTC</span>
                        <span class="admin-orders-card__value fw-semibold">{{ order.totalTtc|number_format(2, ',', ' ') }} €</span>
                    </div>

                    <div class="mt-3">
                        <a href="{{ path('app_admin_order_show', {'id': order.id}) }}"
                           class="btn btn-primary w-100">
                            Voir la commande
                        </a>
                    </div>
                </div>
            </div>
        {% else %}
            <div class="card shadow-sm border-0">
                <div class="card-body text-center py-4 text-muted">
                    Aucune commande.
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}