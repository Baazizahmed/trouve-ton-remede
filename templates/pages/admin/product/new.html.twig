{% extends 'themes/base_admin.html.twig' %}

{% block title %}Nouveau produit{% endblock %}
{% block description %}Nouveau produit{% endblock %}

{% block main %}
<div class="container my-4 my-md-5">

    {% set header_actions %}
        <a href="{{ path('app_admin_product_index') }}" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Administration',
        title: 'Créer un nouveau produit',
        subtitle: 'Ajoutez un nouveau produit au catalogue de la boutique.',
        actions: header_actions
    } %}

    <div class="card shadow-sm border-0 mt-4">
        <div class="card-body p-4 p-lg-5">
            {{ form_start(form) }}

            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <div class="form-group">
                        {{ form_label(form.name, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.name, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.name) }}</div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="form-group">
                        {{ form_label(form.slug, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.slug, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.slug) }}</div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="form-group">
                        {{ form_label(form.description, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="form-group">
                        {{ form_label(form.price, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        <div class="input-group">
                            {{ form_widget(form.price, {'attr': {'class': 'form-control'}}) }}
                            <span class="input-group-text">€</span>
                        </div>
                        <div class="text-danger small mt-1">{{ form_errors(form.price) }}</div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="form-group">
                        {{ form_label(form.imageFile, 'Image du produit', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.imageFile, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.imageFile) }}</div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="form-group">
                        {{ form_label(form.benefits, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.benefits, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.benefits) }}</div>
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="form-group">
                        {{ form_label(form.usage, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.usage, {'attr': {'class': 'form-control', 'rows': 4}}) }}
                        <div class="text-danger small mt-1">{{ form_errors(form.usage) }}</div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-4 pt-4 border-top">
                <p class="text-muted small mb-0">
                    Vérifiez les informations du produit avant la création.
                </p>

                <button type="submit" class="btn btn-success px-4">
                    <i class="fa-solid fa-check me-1"></i>
                    Créer le produit
                </button>
            </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}