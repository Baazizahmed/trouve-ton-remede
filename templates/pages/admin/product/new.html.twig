{% extends 'themes/base_admin.html.twig' %}

{% block title %}Nouveau produit{% endblock %}
{% block description %}Nouveau produit{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Catalogue</span>
{% endblock %}

{% block main %}
<div class="container my-4 my-md-5">

    {% set header_actions %}
        <a href="{{ path('app_admin_product_index') }}" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Administration',
        title: 'Créer un nouveau produit',
        subtitle: 'Ajoutez un nouveau produit au catalogue de la boutique.',
        actions: header_actions
    } %}

    <div class="admin-form-card mt-4">
        <div class="admin-form-card__header">
            <h2 class="admin-form-card__title">Informations du produit</h2>
            <p class="admin-form-card__subtitle">
                Renseignez les informations commerciales, descriptives et visuelles du nouveau produit.
            </p>
        </div>

        <div class="admin-form-card__body">
            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                <div class="row g-4">
                    <div class="col-12 col-xl-8">
                        <div class="admin-form-card__section">
                            <h3 class="admin-form-card__section-title">Contenu principal</h3>

                            <div class="admin-form-card__fields">
                                <div class="row g-4">
                                    <div class="col-12 col-md-6">
                                        <div>
                                            {{ form_label(form.name, null, {
                                                label_attr: { class: 'form-label fw-semibold' }
                                            }) }}
                                            {{ form_widget(form.name, {
                                                attr: {
                                                    class: 'form-control',
                                                    autofocus: 'autofocus',
                                                    placeholder: 'Nom du produit'
                                                }
                                            }) }}
                                            <div class="text-danger small mt-1">{{ form_errors(form.name) }}</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div>
                                            {{ form_label(form.slug, null, {
                                                label_attr: { class: 'form-label fw-semibold' }
                                            }) }}
                                            {{ form_widget(form.slug, {
                                                attr: {
                                                    class: 'form-control',
                                                    placeholder: 'slug-du-produit'
                                                }
                                            }) }}
                                            <div class="text-danger small mt-1">{{ form_errors(form.slug) }}</div>
                                        </div>
                                    </div>

                                    <div class="col-12">
                                        <div>
                                            {{ form_label(form.description, null, {
                                                label_attr: { class: 'form-label fw-semibold' }
                                            }) }}
                                            {{ form_widget(form.description, {
                                                attr: {
                                                    class: 'form-control',
                                                    rows: 4,
                                                    placeholder: 'Description du produit'
                                                }
                                            }) }}
                                            <div class="text-danger small mt-1">{{ form_errors(form.description) }}</div>
                                            <div class="form-text">
                                                Décris clairement le produit, sa promesse et son intérêt pour l’utilisateur.
                                            </div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div>
                                            {{ form_label(form.benefits, null, {
                                                label_attr: { class: 'form-label fw-semibold' }
                                            }) }}
                                            {{ form_widget(form.benefits, {
                                                attr: {
                                                    class: 'form-control',
                                                    rows: 4,
                                                    placeholder: 'Bienfaits principaux du produit'
                                                }
                                            }) }}
                                            <div class="text-danger small mt-1">{{ form_errors(form.benefits) }}</div>
                                        </div>
                                    </div>

                                    <div class="col-12 col-md-6">
                                        <div>
                                            {{ form_label(form.usage, null, {
                                                label_attr: { class: 'form-label fw-semibold' }
                                            }) }}
                                            {{ form_widget(form.usage, {
                                                attr: {
                                                    class: 'form-control',
                                                    rows: 4,
                                                    placeholder: 'Conseils d’utilisation'
                                                }
                                            }) }}
                                            <div class="text-danger small mt-1">{{ form_errors(form.usage) }}</div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-xl-4">
                        <div class="admin-form-card__aside">
                            <h3 class="admin-form-card__section-title">Prix, stock et image</h3> {# MODIF : titre harmonisé #}

                            <div class="admin-form-card__fields">
                                <div>
                                    {{ form_label(form.price, null, {
                                        label_attr: { class: 'form-label fw-semibold' }
                                    }) }}
                                    <div class="input-group">
                                        {{ form_widget(form.price, {
                                            attr: {
                                                class: 'form-control',
                                                placeholder: '0.00'
                                            }
                                        }) }}
                                        <span class="input-group-text">€</span>
                                    </div>
                                    <div class="text-danger small mt-1">{{ form_errors(form.price) }}</div>
                                </div>

                                <div> {# AJOUT : champ stock dans le formulaire admin create #}
                                    {{ form_label(form.stock, null, {
                                        label_attr: { class: 'form-label fw-semibold' }
                                    }) }}
                                    {{ form_widget(form.stock, {
                                        attr: {
                                            class: 'form-control',
                                            min: 0,
                                            placeholder: 'Ex : 12'
                                        }
                                    }) }}
                                    <div class="text-danger small mt-1">{{ form_errors(form.stock) }}</div>
                                    <div class="form-text">
                                        Indiquez la quantité actuellement disponible pour ce produit.
                                    </div>
                                </div>

                                <div>
                                    {{ form_label(form.imageFile, 'Image du produit', {
                                        label_attr: { class: 'form-label fw-semibold' }
                                    }) }}
                                    {{ form_widget(form.imageFile, {
                                        attr: { class: 'form-control' }
                                    }) }}
                                    <div class="text-danger small mt-1">{{ form_errors(form.imageFile) }}</div>
                                    <div class="form-text">
                                        Ajoutez un visuel propre et lisible pour la fiche produit.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-form-card__footer">
                    <p class="admin-form-card__helper mb-0">
                        Vérifiez les informations du produit avant la création.
                    </p>

                    {% include 'components/admin/action_buttons.html.twig' with {
                        align: 'end',
                        stack_mobile: true,
                        tertiary_label: 'Retour à la liste',
                        tertiary_href: path('app_admin_product_index'),
                        tertiary_icon: 'arrow-left',
                        primary_label: 'Créer le produit',
                        primary_type: 'submit',
                        primary_icon: 'check',
                        primary_class: 'btn btn-admin-primary px-4'
                    } %}
                </div>

            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}