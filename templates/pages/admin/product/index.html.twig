{% extends 'themes/base_admin.html.twig' %}

{% block title %}Gestion des produits{% endblock %}
{% block description %}Gestion des produits{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-stretch align-items-md-center gap-3 mb-4">
            <h1 class="text-primary mb-0">Gestion des produits</h1>

            <a href="{{ path('app_admin_product_new') }}" class="btn btn-primary w-100 w-md-auto">
                <i class="fa-solid fa-plus me-2"></i>
                Nouveau produit
            </a>
        </div>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        <div class="table-responsive">
            <table class="table table-striped align-middle text-center mb-0">
                <thead class="table-primary">
                    <tr>
                        <th class="d-none d-lg-table-cell">ID</th>
                        <th>Image</th>
                        <th>Nom</th>
                        <th class="d-none d-lg-table-cell">Slug</th>
                        <th>Prix HT</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for product in products %}
                        <tr>
                            <td class="d-none d-lg-table-cell">{{ product.id }}</td>

                            <td>
                                {% if product.imageName %}
                                    <img
                                        src="{{ asset('images/dynamic/products/' ~ product.imageName) }}"
                                        alt="{{ product.name }}"
                                        class="img-fluid rounded"
                                        style="width: 60px; height: 60px; object-fit: cover;"
                                    >
                                {% else %}
                                    <span class="text-muted small">Aucune image</span>
                                {% endif %}
                            </td>

                            <td class="text-start fw-semibold">{{ product.name }}</td>

                            <td class="d-none d-lg-table-cell">{{ product.slug }}</td>

                            <td>{{ product.price }} €</td>

                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-2 flex-wrap">
                                    <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}"
                                       class="btn btn-sm btn-warning">
                                        Modifier
                                    </a>

                                    <form action="{{ path('app_admin_product_delete', {'id': product.id}) }}"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden"
                                               name="_token"
                                               value="{{ csrf_token('delete_product_' ~ product.id) }}">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger"
                                                onclick="return confirm('Supprimer ce produit ?')">
                                            Supprimer
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">Aucun produit.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}