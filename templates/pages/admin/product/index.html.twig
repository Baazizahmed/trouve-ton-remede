{% extends 'themes/base_admin.html.twig' %}

{% block title %}Gestion des produits{% endblock %}
{% block description %}Gestion des produits{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Catalogue produits</span>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">

        {% set productHeaderActions %}
            <a href="{{ path('app_admin_product_new') }}" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i>
                Nouveau produit
            </a>
        {% endset %}

        {% include 'components/admin/page_header.html.twig' with {
            badge: 'Catalogue',
            title: 'Gestion des produits',
            subtitle: 'Gérez les plantes médicinales, leurs informations clés et leur visibilité dans la boutique.',
            actions: productHeaderActions
        } %}

        {% for message in app.flashes('success') %}
            <div class="alert alert-success">{{ message }}</div>
        {% endfor %}

        {% for message in app.flashes('error') %} {# AJOUT : gestion des erreurs CSRF / validation #}
            <div class="alert alert-danger">{{ message }}</div>
        {% endfor %}

        {% set tableContent %}
            <div class="table-responsive">
                <table class="table table-striped align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th class="d-none d-lg-table-cell">ID</th>
                            <th class="admin-products-table__col-image">Image</th> {# MODIF : classe ajoutée pour masquer la colonne en tablette #}
                            <th>Nom</th>
                            <th class="d-none d-lg-table-cell">Slug</th>
                            <th>Prix HT</th>
                            <th>Stock</th> {# MODIF : colonne stock enrichie avec statut plus lisible + quantité exacte #}
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        {% for product in products %}
                            <tr>
                                <td class="d-none d-lg-table-cell">{{ product.id }}</td>

                                <td class="admin-products-table__cell-image"> {# MODIF : classe ajoutée pour masquer la cellule image en tablette #}
                                    <div class="admin-product-thumb">
                                        {% if product.imageName %}
                                            <img
                                                src="{{ asset('images/dynamic/products/' ~ product.imageName) }}"
                                                alt="{{ product.name }}"
                                                class="admin-product-thumb__image"
                                            >
                                        {% else %}
                                            <span class="admin-product-thumb__placeholder">
                                                <i class="fa-regular fa-image" aria-hidden="true"></i>
                                            </span>
                                        {% endif %}
                                    </div>
                                </td>

                                <td class="text-start">
                                    <div class="admin-product-name">
                                        <span class="admin-product-name__title">{{ product.name }}</span>
                                        <span class="admin-product-name__meta d-lg-none">#{{ product.id }}</span>
                                    </div>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    <code class="admin-product-slug">{{ product.slug }}</code>
                                </td>

                                <td>
                                    <span class="badge rounded-pill admin-price-badge">
                                        {{ product.price|number_format(2, ',', ' ') }} €
                                    </span>
                                </td>

                                <td>
                                    {# MODIF : ajout d’un état visuel spécifique quand le stock est à 0 #}
                                    <form
                                        action="{{ path('app_admin_product_stock_update', { id: product.id }) }}"
                                        method="post"
                                        class="admin-stock-inline-form {% if product.stock <= 0 %}admin-stock-inline-form--out{% endif %}"
                                    >
                                        <input
                                            type="hidden"
                                            name="_token"
                                            value="{{ csrf_token('update_stock_' ~ product.id) }}"
                                        >

                                        <div class="admin-stock-inline">
                                            {# AJOUT : bouton - pour diminuer la quantité visuellement avant validation #}
                                            <button
                                                type="button"
                                                class="admin-stock-inline__btn"
                                                onclick="this.parentNode.querySelector('.admin-stock-inline__input').stepDown()"
                                                aria-label="Diminuer le stock de {{ product.name }}"
                                            >
                                                -
                                            </button>

                                            {# AJOUT : quantité éditable directement #}
                                            <input
                                                type="number"
                                                name="stock"
                                                value="{{ product.stock }}"
                                                min="0"
                                                class="admin-stock-inline__input"
                                                aria-label="Stock de {{ product.name }}"
                                            >

                                            {# AJOUT : bouton + pour augmenter la quantité visuellement avant validation #}
                                            <button
                                                type="button"
                                                class="admin-stock-inline__btn"
                                                onclick="this.parentNode.querySelector('.admin-stock-inline__input').stepUp()"
                                                aria-label="Augmenter le stock de {{ product.name }}"
                                            >
                                                +
                                            </button>

                                            {# AJOUT : validation explicite pour rester simple et fiable #}
                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-admin-primary admin-stock-inline__submit"
                                            >
                                                Valider
                                            </button>
                                        </div>

                                        <div class="admin-stock-inline__status">
                                            {% if product.stock <= 0 %}
                                                <span class="admin-stock-badge admin-stock-badge--out">
                                                    <span class="admin-stock-badge__dot" aria-hidden="true"></span> {# AJOUT : repère visuel #}
                                                    Rupture
                                                    <span class="admin-stock-badge__count">· 0 unité</span> {# AJOUT : quantité exacte affichée #}
                                                </span>
                                            {% elseif product.stock <= 5 %}
                                                <span class="admin-stock-badge admin-stock-badge--low">
                                                    <span class="admin-stock-badge__dot" aria-hidden="true"></span> {# AJOUT : repère visuel #}
                                                    Stock faible
                                                    <span class="admin-stock-badge__count">· {{ product.stock }} unité{% if product.stock > 1 %}s{% endif %}</span> {# AJOUT : quantité exacte affichée #}
                                                </span>
                                            {% else %}
                                                <span class="admin-stock-badge admin-stock-badge--in">
                                                    <span class="admin-stock-badge__dot" aria-hidden="true"></span> {# AJOUT : repère visuel #}
                                                    En stock
                                                    <span class="admin-stock-badge__count">· {{ product.stock }} unité{% if product.stock > 1 %}s{% endif %}</span> {# AJOUT : quantité exacte affichée #}
                                                </span>
                                            {% endif %}
                                        </div>

                                        <div class="admin-stock-inline__hint">
                                            {# AJOUT : aide textuelle discrète pour rendre l’état plus explicite #}
                                            {% if product.stock <= 0 %}
                                                Produit actuellement indisponible à la vente.
                                            {% elseif product.stock <= 5 %}
                                                Pensez à anticiper le réassort.
                                            {% else %}
                                                Stock disponible pour la boutique.
                                            {% endif %}
                                        </div>
                                    </form>
                                </td>

                                <td>
                                    <div class="admin-table-actions">
                                        <a href="{{ path('app_admin_product_edit', {'id': product.id}) }}"
                                           class="btn btn-sm admin-action-btn admin-action-btn--edit">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Modifier</span>
                                        </a>

                                        <form action="{{ path('app_admin_product_delete', {'id': product.id}) }}"
                                              method="post"
                                              class="d-inline">
                                            <input
                                                type="hidden"
                                                name="_token"
                                                value="{{ csrf_token('delete_product_' ~ product.id) }}"
                                            >

                                            <button
                                                type="submit"
                                                class="btn btn-sm admin-action-btn admin-action-btn--delete"
                                                onclick="return confirm('Supprimer ce produit ?')"
                                            >
                                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                <span>Supprimer</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set emptyState %}
            <div class="admin-empty-state">
                <div class="admin-empty-state__icon">
                    <i class="fa-solid fa-seedling" aria-hidden="true"></i>
                </div>

                <h3 class="admin-empty-state__title">Aucun produit pour le moment</h3>

                <p class="admin-empty-state__text">
                    Commencez par créer votre premier produit pour alimenter le catalogue de la boutique.
                </p>

                <a href="{{ path('app_admin_product_new') }}" class="btn btn-primary">
                    <i class="fa-solid fa-plus me-2"></i>
                    Ajouter un produit
                </a>
            </div>
        {% endset %}

        <div class="mt-4">
            {% include 'components/admin/table_card.html.twig' with {
                title: 'Catalogue produits',
                subtitle: 'Retrouvez ici l’ensemble des produits disponibles dans l’administration.',
                actions: null,
                table: products|length ? tableContent : null,
                empty_state: products|length ? null : emptyState,
                body_class: products|length ? 'is-flush' : ''
            } %}
        </div>
    </div>
{% endblock %}