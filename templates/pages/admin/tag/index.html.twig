{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des tags{% endblock %}
{% block description %}Liste des tags{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
{% endblock %}

{% block dataTables %}
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.css"
          rel="stylesheet"
          integrity="sha384-euvbLDizNhjdB+SK/Ai+GY3WCCHaDJM1tnnh2IqvUY9zjhlo21JkywSg8X5hlMY8"
          crossorigin="anonymous">

    <script src="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.js"
            integrity="sha384-1LmfH5u7+DRwux/q4YYqAi+OjwkIVYJdPQijPS9S28cj8AeFnpNCkSVlZgvRdOzb"
            crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            $('#myTable').DataTable({
                responsive: true,
                scrollX: true,
                autoWidth: false,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.3.1/i18n/fr-FR.json'
                },
                columnDefs: [
                    { responsivePriority: 5, targets: 0 },
                    { responsivePriority: 1, targets: 1 },
                    { responsivePriority: 4, targets: 2 },
                    { responsivePriority: 6, targets: 3 },
                    { responsivePriority: 7, targets: 4 },
                    { responsivePriority: 1, targets: 5 },
                    { orderable: false, targets: [5] }
                ]
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">

        {% set tagHeaderActions %}
            <a href="{{ path('app_admin_tag_create') }}" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i>
                Nouveau tag
            </a>
        {% endset %}

        {% include 'components/admin/page_header.html.twig' with {
            badge: 'Tags',
            title: 'Liste des tags',
            subtitle: 'Gérez les tags du blog et organisez plus facilement les articles associés.',
            actions: tagHeaderActions
        } %}

        {% include 'components/alert.html.twig' %}

        {% set tableContent %}
            <div class="table-responsive">
                <table id="myTable" class="table table-striped align-middle text-center w-100 mb-0">
                    <thead>
                        <tr>
                            <th data-priority="5" class="d-none d-md-table-cell">Id</th>
                            <th data-priority="1">Nom</th>
                            <th data-priority="4" class="d-none d-md-table-cell">Slug</th>
                            <th data-priority="6" class="d-none d-lg-table-cell">Créé le</th>
                            <th data-priority="7" class="d-none d-lg-table-cell">Modifié le</th>
                            <th data-priority="1">Options</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for tag in tags %}
                            <tr>
                                <td class="d-none d-md-table-cell">{{ tag.id }}</td>

                                <td class="text-start">
                                    <div class="admin-tag-name">
                                        <span class="admin-tag-name__main">
                                            {{ tag.name }}
                                        </span>
                                    </div>
                                </td>

                                <td class="d-none d-md-table-cell">
                                    <span class="text-muted">{{ tag.slug }}</span>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    {{ tag.createdAt|date('d/m/Y') }}
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    {{ tag.updatedAt|date('d/m/Y') }}
                                </td>

                                <td>
                                    <div class="admin-table-actions">
                                        <a href="{{ path('app_admin_tag_edit', {'id': tag.id}) }}"
                                           class="btn btn-sm admin-action-btn admin-action-btn--edit"
                                           aria-label="Modifier le tag {{ tag.name }}">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Modifier</span>
                                        </a>

                                        <form action="{{ path('app_admin_tag_delete', {'id': tag.id}) }}"
                                              method="post"
                                              class="d-inline">
                                            <input type="hidden"
                                                   name="csrf_token"
                                                   value="{{ csrf_token('delete-tag-' ~ tag.id) }}">

                                            <button type="submit"
                                                    class="btn btn-sm admin-action-btn admin-action-btn--delete"
                                                    onclick="return confirm('Attention !!! En supprimant ce tag, vous supprimerez tous ses articles associés. Confirmer la suppression ?')"
                                                    aria-label="Supprimer le tag {{ tag.name }}">
                                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                <span>Supprimer</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set emptyState %}
            <div class="admin-empty-state">
                <div class="admin-empty-state__icon">
                    <i class="fa-solid fa-tags" aria-hidden="true"></i>
                </div>

                <h3 class="admin-empty-state__title">Aucun tag pour le moment</h3>

                <p class="admin-empty-state__text">
                    Créez un premier tag pour mieux organiser les articles du blog.
                </p>

                <a href="{{ path('app_admin_tag_create') }}" class="btn btn-primary">
                    <i class="fa-solid fa-plus me-2"></i>
                    Ajouter un tag
                </a>
            </div>
        {% endset %}

        <div class="mt-4">
            {% include 'components/admin/table_card.html.twig' with {
                title: 'Tags du blog',
                subtitle: 'Retrouvez ici les tags disponibles et gérez rapidement leur organisation.',
                actions: null,
                table: tags|length ? tableContent : null,
                empty_state: tags|length ? null : emptyState,
                body_class: tags|length ? 'is-flush' : ''
            } %}
        </div>
    </div>
{% endblock %}