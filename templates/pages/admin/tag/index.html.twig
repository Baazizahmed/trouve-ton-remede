{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des tags{% endblock %}
{% block description %}Liste des tags{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
{% endblock %}

{% block dataTables %}
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.css"
          rel="stylesheet"
          integrity="sha384-euvbLDizNhjdB+SK/Ai+GY3WCCHaDJM1tnnh2IqvUY9zjhlo21JkywSg8X5hlMY8"
          crossorigin="anonymous">

    <script src="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.js"
            integrity="sha384-1LmfH5u7+DRwux/q4YYqAi+OjwkIVYJdPQijPS9S28cj8AeFnpNCkSVlZgvRdOzb"
            crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            $('#myTable').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.3.1/i18n/fr-FR.json'
                },
                columnDefs: [
                    { responsivePriority: 1, targets: 1 }, // Nom
                    { responsivePriority: 2, targets: 5 }, // Options
                    { responsivePriority: 3, targets: 0 }  // Id
                ]
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3">
        <h1 class="text-center text-primary my-3 display-6">🌿 Liste des tags</h1>

        {% include 'components/alert.html.twig' %}

        <div class="d-flex justify-content-center justify-content-md-end align-items-center my-3">
            <a href="{{ path('app_admin_tag_create') }}" class="btn btn-primary shadow w-100">
                <i class="fa-solid fa-plus me-2"></i>
                Nouveau tag
            </a>
        </div>

        <div class="table-responsive">
            <table id="myTable" class="table table-striped table-bordered text-center align-middle w-100">
                <thead class="table-primary">
                    <tr>
                        <th data-priority="3">Id</th>
                        <th data-priority="1">Nom</th>
                        <th data-priority="4" class="d-none d-md-table-cell">Slug</th>
                        <th data-priority="5" class="d-none d-lg-table-cell">Créé le</th>
                        <th data-priority="6" class="d-none d-lg-table-cell">Modifié le</th>
                        <th data-priority="2">Options</th>
                    </tr>
                </thead>
                <tbody>
                    {% for tag in tags %}
                        <tr>
                            <td>{{ tag.id }}</td>
                            <td>{{ tag.name }}</td>
                            <td class="d-none d-md-table-cell">{{ tag.slug }}</td>
                            <td class="d-none d-lg-table-cell">{{ tag.createdAt|date() }}</td>
                            <td class="d-none d-lg-table-cell">{{ tag.updatedAt|date() }}</td>
                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-3 flex-nowrap">
                                    <a href="{{ path('app_admin_tag_edit', {'id': tag.id}) }}"
                                       class="text-secondary text-decoration-none"
                                       title="Modifier"
                                       aria-label="Modifier le tag {{ tag.name }}">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <form class="d-inline"
                                          action="{{ path('app_admin_tag_delete', {'id': tag.id}) }}"
                                          method="post">
                                        <input type="hidden"
                                               name="csrf_token"
                                               value="{{ csrf_token('delete-tag-' ~ tag.id) }}">

                                        <button type="submit"
                                                class="border-0 bg-transparent p-0 text-danger"
                                                onclick="return confirm('Attention !!! En supprimant ce tag, vous supprimerez tous ses articles associés. Confirmer la suppression ?')"
                                                title="Supprimer"
                                                aria-label="Supprimer le tag {{ tag.name }}">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}