{% extends 'themes/base_admin.html.twig' %}

{% block title %}Modifier ce tag{% endblock %}

{% block description %}Modifier ce tag{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Contenus</span>
{% endblock %}

{% block main %}
<div class="container mt-4">

    {% set header_actions %}
        <a href="{{ path('app_admin_tag_index') }}" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Administration',
        title: 'Modifier ce tag',
        subtitle: 'Mettez à jour le nom du tag.',
        actions: header_actions
    } %}

    <div class="row justify-content-center mt-4">
        <div class="col-md-8 col-lg-6">
            <div class="admin-form-card">
                <div class="admin-form-card__header">
                    <h2 class="admin-form-card__title">Informations du tag</h2>
                    <p class="admin-form-card__subtitle">
                        Modifiez les informations puis enregistrez les changements.
                    </p>
                </div>

                <div class="admin-form-card__body">
                    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                        <div class="admin-form-card__fields">
                            <div class="mb-4">
                                {{ form_label(form.name, 'Nom', {
                                    label_attr: { class: 'form-label fw-semibold' }
                                }) }}

                                <div class="text-danger small mb-1">
                                    {{ form_errors(form.name) }}
                                </div>

                                {{ form_widget(form.name, {
                                    attr: {
                                        class: 'form-control',
                                        autofocus: 'autofocus',
                                        placeholder: 'Nom du tag'
                                    }
                                }) }}

                                <div class="form-text">
                                    Gardez un libellé clair, court et cohérent avec les autres tags.
                                </div>
                            </div>
                        </div>

                        <div class="admin-form-card__footer">
                            <p class="admin-form-card__helper mb-0">
                                Vérifiez le nom avant d’enregistrer pour conserver une taxonomie propre.
                            </p>

                            {% include 'components/admin/action_buttons.html.twig' with {
                                align: 'end',
                                stack_mobile: true,
                                tertiary_label: 'Retour à la liste',
                                tertiary_href: path('app_admin_tag_index'),
                                tertiary_icon: 'arrow-left',
                                primary_label: 'Enregistrer les modifications',
                                primary_type: 'submit',
                                primary_icon: 'floppy-disk',
                                primary_class: 'btn btn-admin-primary px-4'
                            } %}
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}