{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des catégories{% endblock %}
{% block description %}Liste des catégories{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Organisation du blog</span>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">

        {% set categoryHeaderActions %}
            <a href="{{ path('app_admin_category_create') }}" class="btn btn-primary">
                <i class="fa-solid fa-plus me-2"></i>
                Nouvelle catégorie
            </a>
        {% endset %}

        {% include 'components/admin/page_header.html.twig' with {
            badge: 'Blog',
            title: 'Liste des catégories',
            subtitle: 'Gérez les catégories du blog et organisez vos articles plus facilement.',
            actions: categoryHeaderActions
        } %}

        {% include 'components/alert.html.twig' %}

        {% set tableContent %}
            <div class="table-responsive">
                <table id="categoriesTable" class="table table-striped align-middle text-center w-100 mb-0">
                    <thead>
                        <tr>
                            <th data-priority="5" class="d-none d-md-table-cell">Id</th>
                            <th data-priority="1">Nom</th>
                            <th data-priority="4" class="d-none d-md-table-cell">Slug</th>
                            <th data-priority="6" class="d-none d-lg-table-cell">Créé le</th>
                            <th data-priority="7" class="d-none d-lg-table-cell">Modifié le</th>
                            <th data-priority="1">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for category in categories %}
                            <tr>
                                <td class="d-none d-md-table-cell">
                                    <span class="admin-category-id">#{{ category.id }}</span>
                                </td>

                                <td class="text-start">
                                    <div class="admin-category-name">
                                        <span class="admin-category-name__title" title="{{ category.name }}">
                                            {{ category.name }}
                                        </span>
                                    </div>
                                </td>

                                <td class="d-none d-md-table-cell">
                                    <code class="admin-category-slug">{{ category.slug }}</code>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    <span class="admin-category-date">
                                        {{ category.createdAt|date('d/m/Y H:i') }}
                                    </span>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    <span class="admin-category-date">
                                        {{ category.updatedAt|date('d/m/Y H:i') }}
                                    </span>
                                </td>

                                <td>
                                    <div class="admin-table-actions">
                                        <a href="{{ path('app_admin_category_edit', {'id': category.id}) }}"
                                           class="btn btn-sm admin-action-btn admin-action-btn--edit"
                                           aria-label="Modifier la catégorie {{ category.name }}">
                                            <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                            <span>Modifier</span>
                                        </a>

                                        <form class="d-inline"
                                              action="{{ path('app_admin_category_delete', {'id': category.id}) }}"
                                              method="post">
                                            <input type="hidden"
                                                   name="csrf_token"
                                                   value="{{ csrf_token('delete-category-' ~ category.id) }}">

                                            <button type="submit"
                                                    class="btn btn-sm admin-action-btn admin-action-btn--delete"
                                                    onclick="return confirm('Attention : en supprimant cette catégorie, vous supprimerez aussi ses articles associés. Confirmer la suppression ?')"
                                                    aria-label="Supprimer la catégorie {{ category.name }}">
                                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                <span>Supprimer</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set emptyState %}
            <div class="admin-empty-state">
                <div class="admin-empty-state__icon">
                    <i class="fa-solid fa-folder-open" aria-hidden="true"></i>
                </div>

                <h3 class="admin-empty-state__title">Aucune catégorie pour le moment</h3>

                <p class="admin-empty-state__text">
                    Créez une première catégorie pour mieux organiser les articles du blog.
                </p>

                <a href="{{ path('app_admin_category_create') }}" class="btn btn-primary">
                    <i class="fa-solid fa-plus me-2"></i>
                    Ajouter une catégorie
                </a>
            </div>
        {% endset %}

        <div class="mt-4">
            {% include 'components/admin/table_card.html.twig' with {
                title: 'Catégories',
                subtitle: 'Retrouvez ici toutes les catégories disponibles dans le blog.',
                actions: null,
                table: categories|length ? tableContent : null,
                empty_state: categories|length ? null : emptyState,
                body_class: categories|length ? 'is-flush' : ''
            } %}
        </div>
    </div>
{% endblock %}