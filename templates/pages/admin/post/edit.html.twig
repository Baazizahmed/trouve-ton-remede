{% extends 'themes/base_admin.html.twig' %}

{% block title %}Modifier l'article n°{{ post.id }}{% endblock %}
{% block description %}Modifier l'article n°{{ post.id }}{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js" integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
{% endblock %}

{% block select2 %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function() {
            $('#admin_post_form_tags').select2({
                width: '100%',
                placeholder: 'Sélectionnez un ou plusieurs tags'
            });
        });
    </script>
{% endblock %}

{% block main %}
<div class="container mt-4">

    {% set header_actions %}
        <a href="{{ path('app_admin_post_index') }}" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Administration',
        title: 'Modifier cet article',
        subtitle: 'Article n°' ~ post.id ~ ' — ' ~ post.title,
        actions: header_actions
    } %}

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 p-lg-5">
            {{ form_start(form) }}

                <div class="row g-4">
                    <div class="col-12 col-lg-8">
                        <h2 class="h5 mb-4">Contenu principal</h2>

                        <div class="mb-4">
                            {{ form_label(form.title, 'Titre', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="text-danger small mb-1">{{ form_errors(form.title) }}</div>
                            {{ form_widget(form.title, {
                                attr: {
                                    class: 'form-control',
                                    autofocus: 'autofocus',
                                    placeholder: 'Titre de l’article'
                                }
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.description, 'Description', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="text-danger small mb-1">{{ form_errors(form.description) }}</div>
                            {{ form_widget(form.description, {
                                attr: {
                                    class: 'form-control',
                                    rows: 3
                                }
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.content, 'Contenu', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="text-danger small mb-1">{{ form_errors(form.content) }}</div>
                            {{ form_widget(form.content, {
                                attr: {
                                    class: 'form-control',
                                    rows: 10
                                }
                            }) }}
                        </div>
                    </div>

                    <div class="col-12 col-lg-4">
                        <h2 class="h5 mb-4">Organisation</h2>

                        <div class="mb-4">
                            {{ form_label(form.category, 'Catégorie', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="text-danger small mb-1">{{ form_errors(form.category) }}</div>
                            {{ form_widget(form.category, {
                                attr: {
                                    class: 'form-control'
                                }
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.tags, 'Tags', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="text-danger small mb-1">{{ form_errors(form.tags) }}</div>
                            {{ form_widget(form.tags, {
                                attr: {
                                    class: 'form-control'
                                }
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.keywords, 'Mots clés', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="text-danger small mb-1">{{ form_errors(form.keywords) }}</div>
                            {{ form_widget(form.keywords, {
                                attr: {
                                    class: 'form-control',
                                    placeholder: 'plantes, bienfaits, infusion...'
                                }
                            }) }}
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold">Image actuelle</label>

                            {% if post.image %}
                                <div class="border rounded p-2 bg-light text-center mb-3">
                                    <img
                                        src="{{ vich_uploader_asset(post, 'imageFile') | imagine_filter('admin_post_thumb') }}"
                                        alt="{{ post.title }}"
                                        class="img-fluid rounded"
                                    >
                                </div>
                            {% else %}
                                <div class="border rounded p-3 bg-light text-muted small text-center mb-3">
                                    Aucune image existante
                                </div>
                            {% endif %}

                            {{ form_label(form.imageFile, 'Sélectionnez une nouvelle image', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            <div class="text-danger small mb-1">{{ form_errors(form.imageFile) }}</div>
                            {{ form_widget(form.imageFile, {
                                attr: {
                                    class: 'form-control'
                                }
                            }) }}
                        </div>
                    </div>
                </div>

                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mt-4 pt-4 border-top">
                    <p class="text-muted small mb-0">
                        Vérifiez les contenus, métadonnées et visuel avant d’enregistrer.
                    </p>

                    <button formnovalidate type="submit" class="btn btn-primary px-4">
                        Sauvegarder l’article
                    </button>
                </div>

            {{ form_end(form) }}
        </div>
    </div>

</div>
{% endblock %}