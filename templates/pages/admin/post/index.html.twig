{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des articles{% endblock %}
{% block description %}Liste des articles{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
{% endblock %}

{% block dataTables %}
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.css"
          rel="stylesheet"
          integrity="sha384-euvbLDizNhjdB+SK/Ai+GY3WCCHaDJM1tnnh2IqvUY9zjhlo21JkywSg8X5hlMY8"
          crossorigin="anonymous">

    <script src="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.js"
            integrity="sha384-1LmfH5u7+DRwux/q4YYqAi+OjwkIVYJdPQijPS9S28cj8AeFnpNCkSVlZgvRdOzb"
            crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            $('#myTable').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.3.1/i18n/fr-FR.json'
                },
                columnDefs: [
                    { responsivePriority: 1, targets: 2 }, // Titre
                    { responsivePriority: 2, targets: 5 }, // Publié
                    { responsivePriority: 3, targets: 8 }, // Options
                    { responsivePriority: 4, targets: 0 }  // Id
                ]
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3">
        <h1 class="text-center text-primary my-3 display-6">🌿 Liste des articles</h1>

        {% include 'components/alert.html.twig' %}

        <div class="d-flex justify-content-center justify-content-md-end align-items-center my-3">
            <a href="{{ path('app_admin_post_create') }}" class="btn btn-primary shadow w-100">
                <i class="fa-solid fa-plus me-2"></i>
                Nouvel article
            </a>
        </div>

        <div class="table-responsive">
            <table id="myTable" class="table table-striped table-hover table-bordered text-center align-middle w-100">
                <thead class="table-primary">
                    <tr>
                        <th data-priority="4">Id</th>
                        <th data-priority="5" class="d-none d-md-table-cell">Image</th>
                        <th data-priority="1">Titre</th>
                        <th data-priority="6" class="d-none d-md-table-cell">Catégorie</th>
                        <th data-priority="7" class="d-none d-lg-table-cell">Tags</th>
                        <th data-priority="2">Publié ?</th>
                        <th data-priority="8" class="d-none d-lg-table-cell">Contenu</th>
                        <th data-priority="9" class="d-none d-lg-table-cell">Créé le</th>
                        <th data-priority="3">Options</th>
                    </tr>
                </thead>
                <tbody>
                    {% for post in posts %}
                        <tr>
                            <td>{{ post.id }}</td>

                            <td class="d-none d-md-table-cell">
                                {% if post.image %}
                                    <img src="{{ vich_uploader_asset(post, 'imageFile') | imagine_filter('admin_post_thumb') }}"
                                         alt="{{ post.title }}"
                                         class="img-fluid rounded"
                                         style="max-width: 70px;">
                                {% else %}
                                    <span>---</span>
                                {% endif %}
                            </td>

                            <td>{{ post.title }}</td>

                            <td class="d-none d-md-table-cell">{{ post.category.name }}</td>

                            <td class="d-none d-lg-table-cell">
                                {% if post.tags is not empty %}
                                    {% for tag in post.tags %}
                                        <span class="badge bg-secondary"># {{ tag.name }}</span>
                                    {% endfor %}
                                {% else %}
                                    <span>—</span>
                                {% endif %}
                            </td>

                            <td>
                                {% if post.isPublished %}
                                    <span><i class="fa-regular fa-calendar-check"></i> publié</span>
                                {% else %}
                                    <span class="text-danger"><i class="fa-solid fa-circle-xmark"></i></span>
                                {% endif %}

                                <form action="{{ path('app_admin_post_publish', {'id': post.id}) }}" method="post">
                                    <div class="form-check form-switch d-flex justify-content-center align-items-center mt-2">
                                        <input type="hidden" name="csrf_token" value="{{ csrf_token('publish-post-' ~ post.id) }}">
                                        <input {{ post.isPublished ? 'checked' : '' }}
                                               onclick="return confirm('Confirmer cette action ?')"
                                               onchange="this.form.submit()"
                                               class="form-check-input"
                                               type="checkbox">
                                    </div>
                                </form>
                            </td>

                            <td class="d-none d-lg-table-cell">
                                <a href="{{ path('app_admin_post_show', {'id': post.id}) }}" class="btn btn-sm btn-primary">
                                    Lire
                                </a>
                            </td>

                            <td class="d-none d-lg-table-cell">{{ post.createdAt|date() }}</td>

                            <td>
                                <div class="d-flex justify-content-center align-items-center gap-3 flex-nowrap">
                                    <a href="{{ path('app_admin_post_edit', {'id': post.id}) }}"
                                       class="text-secondary text-decoration-none"
                                       title="Modifier"
                                       aria-label="Modifier l'article {{ post.title }}">
                                        <i class="fa-solid fa-pen-to-square"></i>
                                    </a>

                                    <form action="{{ path('app_admin_post_delete', {'id': post.id}) }}"
                                          method="post"
                                          class="d-inline">
                                        <input type="hidden"
                                               name="csrf_token"
                                               value="{{ csrf_token('delete-post-' ~ post.id) }}">

                                        <button type="submit"
                                                class="border-0 bg-transparent p-0 text-danger"
                                                onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet article ?')"
                                                title="Supprimer"
                                                aria-label="Supprimer l'article {{ post.title }}">
                                            <i class="fa-solid fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}