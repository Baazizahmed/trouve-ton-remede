{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}
{% block description %}Liste des utilisateurs{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Gestion des comptes</span>
{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
{% endblock %}

{% block dataTables %}
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.css"
          rel="stylesheet"
          integrity="sha384-euvbLDizNhjdB+SK/Ai+GY3WCCHaDJM1tnnh2IqvUY9zjhlo21JkywSg8X5hlMY8"
          crossorigin="anonymous">

    <script src="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.js"
            integrity="sha384-1LmfH5u7+DRwux/q4YYqAi+OjwkIVYJdPQijPS9S28cj8AeFnpNCkSVlZgvRdOzb"
            crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            $('#myTable').DataTable({
                responsive: true,
                scrollX: true,
                autoWidth: false,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.3.1/i18n/fr-FR.json'
                },
                columnDefs: [
                    { responsivePriority: 6, targets: 0 },
                    { responsivePriority: 1, targets: 1 },
                    { responsivePriority: 5, targets: 2 },
                    { responsivePriority: 4, targets: 3 },
                    { responsivePriority: 2, targets: 4 },
                    { responsivePriority: 7, targets: 5 },
                    { responsivePriority: 8, targets: 6 },
                    { responsivePriority: 1, targets: 7 },
                    { orderable: false, targets: [4, 7] }
                ]
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">

        {% include 'components/admin/page_header.html.twig' with {
            badge: 'Utilisateurs',
            title: 'Liste des utilisateurs',
            subtitle: 'Consultez les comptes utilisateurs, leurs rôles et les actions d’administration disponibles.'
        } %}

        {% include 'components/alert.html.twig' %}

        {% set tableContent %}
            <div class="table-responsive">
                <table id="myTable" class="table table-striped align-middle text-center w-100 mb-0">
                    <thead>
                        <tr>
                            <th data-priority="6" class="d-none d-md-table-cell">Id</th>
                            <th data-priority="1">Utilisateur</th>
                            <th data-priority="5" class="d-none d-lg-table-cell">Email</th>
                            <th data-priority="4" class="d-none d-md-table-cell">Statut</th>
                            <th data-priority="2">Rôles</th>
                            <th data-priority="7" class="d-none d-lg-table-cell">Créé le</th>
                            <th data-priority="8" class="d-none d-lg-table-cell">Modifié le</th>
                            <th data-priority="1">Options</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for user in users %}
                            <tr>
                                <td class="d-none d-md-table-cell">{{ user.id }}</td>

                                <td class="text-start">
                                    <div class="admin-user-name">
                                        <span class="admin-user-name__main fw-semibold">
                                            {{ user.firstName }} {{ user.lastName }}
                                        </span>
                                    </div>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    <span class="text-muted">{{ user.email }}</span>
                                </td>

                                <td class="d-none d-md-table-cell">
                                    {% if user.isVerified %}
                                        <span class="badge rounded-pill bg-success">Vérifié</span>
                                    {% else %}
                                        <span class="badge rounded-pill bg-danger">Non vérifié</span>
                                    {% endif %}
                                </td>

                                <td>
                                    <div class="admin-user-roles">
                                        {% for role in user.roles %}
                                            <span class="badge bg-secondary m-1">{{ role }}</span>
                                        {% endfor %}
                                    </div>
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    {{ user.createdAt|date('d/m/Y') }}
                                </td>

                                <td class="d-none d-lg-table-cell">
                                    {{ user.updatedAt|date('d/m/Y') }}
                                </td>

                                <td>
                                    {% if 'ROLE_SUPER_ADMIN' not in user.roles %}
                                        <div class="admin-table-actions">
                                            <a href="{{ path('app_admin_user_edit_roles', {'id': user.id}) }}"
                                               class="btn btn-sm admin-action-btn admin-action-btn--edit"
                                               aria-label="Modifier les rôles de {{ user.firstName }} {{ user.lastName }}">
                                                <i class="fa-solid fa-pen-to-square" aria-hidden="true"></i>
                                                <span>Modifier</span>
                                            </a>

                                            <form action="{{ path('app_admin_user_delete', {'id': user.id}) }}"
                                                  method="post"
                                                  class="d-inline">
                                                <input type="hidden"
                                                       name="csrf_token"
                                                       value="{{ csrf_token('delete-user-' ~ user.id) }}">

                                                <button type="submit"
                                                        class="btn btn-sm admin-action-btn admin-action-btn--delete"
                                                        onclick="return confirm('Confirmer la suppression ?')"
                                                        aria-label="Supprimer l'utilisateur {{ user.firstName }} {{ user.lastName }}">
                                                    <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                    <span>Supprimer</span>
                                                </button>
                                            </form>
                                        </div>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set emptyState %}
            <div class="admin-empty-state">
                <div class="admin-empty-state__icon">
                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                </div>

                <h3 class="admin-empty-state__title">Aucun utilisateur trouvé</h3>

                <p class="admin-empty-state__text">
                    Les comptes utilisateurs apparaîtront ici lorsqu’ils seront créés sur la plateforme.
                </p>
            </div>
        {% endset %}

        <div class="mt-4">
            {% include 'components/admin/table_card.html.twig' with {
                title: 'Comptes utilisateurs',
                subtitle: 'Retrouvez ici les utilisateurs inscrits, leur statut et leurs rôles.',
                actions: null,
                table: users|length ? tableContent : null,
                empty_state: users|length ? null : emptyState,
                body_class: users|length ? 'is-flush' : ''
            } %}
        </div>
    </div>
{% endblock %}