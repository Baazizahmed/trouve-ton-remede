{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des utilisateurs{% endblock %}
{% block description %}Liste des utilisateurs{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
{% endblock %}

{% block dataTables %}
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.css"
          rel="stylesheet"
          integrity="sha384-euvbLDizNhjdB+SK/Ai+GY3WCCHaDJM1tnnh2IqvUY9zjhlo21JkywSg8X5hlMY8"
          crossorigin="anonymous">

    <script src="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.js"
            integrity="sha384-1LmfH5u7+DRwux/q4YYqAi+OjwkIVYJdPQijPS9S28cj8AeFnpNCkSVlZgvRdOzb"
            crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            $('#myTable').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.3.1/i18n/fr-FR.json'
                },
                columnDefs: [
                    { responsivePriority: 1, targets: 1 },
                    { responsivePriority: 2, targets: 4 },
                    { responsivePriority: 3, targets: 7 }
                ]
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">

        {% include 'components/admin/page_header.html.twig' with {
            badge: 'Utilisateurs',
            title: 'Liste des utilisateurs',
            subtitle: 'Consultez les comptes utilisateurs, leurs rôles et les actions d’administration disponibles.'
        } %}

        {% include 'components/alert.html.twig' %}

        <div class="table-responsive">
            <table id="myTable" class="table table-striped table-bordered text-center align-middle w-100">
                <thead class="table-primary">
                    <tr>
                        <th class="d-none d-lg-table-cell">Id</th>
                        <th data-priority="1">Utilisateur</th>
                        <th class="d-none d-lg-table-cell">Email</th>
                        <th class="d-none d-lg-table-cell">Statut</th>
                        <th data-priority="2">Rôles</th>
                        <th class="d-none d-lg-table-cell">Créé le</th>
                        <th class="d-none d-lg-table-cell">Modifié le</th>
                        <th data-priority="3">Options</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                        <tr>
                            <td class="d-none d-lg-table-cell">{{ user.id }}</td>

                            <td class="text-start">
                                <div class="fw-semibold">{{ user.firstName }} {{ user.lastName }}</div>
                            </td>

                            <td class="d-none d-lg-table-cell">{{ user.email }}</td>

                            <td class="d-none d-lg-table-cell">
                                {% if user.isVerified %}
                                    <span class="badge bg-success">Vérifié</span>
                                {% else %}
                                    <span class="badge bg-danger">Non vérifié</span>
                                {% endif %}
                            </td>

                            <td>
                                {% for role in user.roles %}
                                    <span class="badge bg-secondary m-1">{{ role }}</span>
                                {% endfor %}
                            </td>

                            <td class="d-none d-lg-table-cell">{{ user.createdAt|date() }}</td>
                            <td class="d-none d-lg-table-cell">{{ user.updatedAt|date() }}</td>

                            <td>
                                {% if 'ROLE_SUPER_ADMIN' not in user.roles %}
                                    <div class="d-flex justify-content-center align-items-center gap-3 flex-nowrap">
                                        <a href="{{ path('app_admin_user_edit_roles', {'id': user.id}) }}"
                                           class="text-secondary text-decoration-none"
                                           title="Modifier"
                                           aria-label="Modifier les rôles de {{ user.firstName }} {{ user.lastName }}">
                                            <i class="fa-solid fa-pen-to-square"></i>
                                        </a>

                                        <form class="d-inline"
                                              action="{{ path('app_admin_user_delete', {'id': user.id}) }}"
                                              method="post">
                                            <input type="hidden"
                                                   name="csrf_token"
                                                   value="{{ csrf_token('delete-user-' ~ user.id) }}">

                                            <button type="submit"
                                                    class="border-0 bg-transparent p-0 text-danger"
                                                    onclick="return confirm('Confirmer la suppression ?')"
                                                    title="Supprimer"
                                                    aria-label="Supprimer l'utilisateur {{ user.firstName }} {{ user.lastName }}">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}