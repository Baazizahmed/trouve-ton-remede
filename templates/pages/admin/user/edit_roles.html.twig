{% extends 'themes/base_admin.html.twig' %}

{% block title %}Modifier les rôles{% endblock %}

{% block description %}Modifier les rôles{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Gestion des comptes</span>
{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
{% endblock %}

{% block select2 %}
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#edit_roles_form_roles').select2({
                width: '100%',
                placeholder: 'Sélectionnez un ou plusieurs rôles'
            });
        });
    </script>
{% endblock %}

{% block main %}
<div class="container mt-4">

    {% set header_actions %}
        <a href="{{ path('app_admin_user_index') }}" class="btn btn-outline-secondary">
            Retour à la liste
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Administration',
        title: 'Modifier les rôles',
        subtitle: 'Ajustez les rôles attribués à cet utilisateur.',
        actions: header_actions
    } %}

    <div class="admin-form-card mt-4">
        <div class="admin-form-card__header">
            <h2 class="admin-form-card__title">Gestion des autorisations</h2>
            <p class="admin-form-card__subtitle">
                Sélectionnez les rôles à attribuer à cet utilisateur pour gérer ses accès dans l’administration.
            </p>
        </div>

        <div class="admin-form-card__body">
            {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

                <div class="row g-4 align-items-start">
                    <div class="col-12 col-lg-4">
                        <div class="admin-form-card__aside">
                            <h3 class="admin-form-card__section-title">Aide</h3>
                            <p class="admin-form-card__helper mb-0">
                                Attribuez uniquement les rôles nécessaires. Vérifiez les droits avant validation pour éviter des accès trop larges.
                            </p>
                        </div>
                    </div>

                    <div class="col-12 col-lg-8">
                        <div class="admin-form-card__section">
                            <h3 class="admin-form-card__section-title">Rôles utilisateur</h3>

                            <div class="admin-form-card__fields">
                                <div>
                                    {{ form_label(form.roles, 'Les rôles', {
                                        label_attr: { class: 'form-label fw-semibold' }
                                    }) }}

                                    <div class="text-danger small mb-1">
                                        {{ form_errors(form.roles) }}
                                    </div>

                                    {{ form_widget(form.roles, {
                                        attr: {
                                            class: 'form-control',
                                            autofocus: 'autofocus'
                                        }
                                    }) }}

                                    <div class="form-text">
                                        Vous pouvez sélectionner un ou plusieurs rôles selon le niveau d’accès attendu.
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="admin-form-card__footer">
                    <p class="admin-form-card__helper mb-0">
                        Vérifiez les rôles attribués avant validation.
                    </p>

                    {% include 'components/admin/action_buttons.html.twig' with {
                        align: 'end',
                        stack_mobile: true,
                        tertiary_label: 'Retour à la liste',
                        tertiary_href: path('app_admin_user_index'),
                        tertiary_icon: 'arrow-left',
                        primary_label: 'Enregistrer les modifications',
                        primary_type: 'submit',
                        primary_icon: 'floppy-disk',
                        primary_class: 'btn btn-admin-primary px-4'
                    } %}
                </div>

            {{ form_end(form) }}
        </div>
    </div>

</div>
{% endblock %}