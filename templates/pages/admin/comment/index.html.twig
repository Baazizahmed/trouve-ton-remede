{% extends 'themes/base_admin.html.twig' %}

{% block title %}Liste des commentaires{% endblock %}
{% block description %}Liste des commentaires{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Modération du blog</span>
{% endblock %}

{% block jQuery %}
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"
            integrity="sha512-v2CJ7UaYy4JwqLDIrZUI/4hqeoQieOmAZNXBeQyjo21dadnwR+8ZaIJVT8EE2iyI61OV8e6M8PP2/4hpQINQ/g=="
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>
{% endblock %}

{% block dataTables %}
    <link href="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.css"
          rel="stylesheet"
          integrity="sha384-euvbLDizNhjdB+SK/Ai+GY3WCCHaDJM1tnnh2IqvUY9zjhlo21JkywSg8X5hlMY8"
          crossorigin="anonymous">

    <script src="https://cdn.datatables.net/v/dt/dt-2.3.1/datatables.min.js"
            integrity="sha384-1LmfH5u7+DRwux/q4YYqAi+OjwkIVYJdPQijPS9S28cj8AeFnpNCkSVlZgvRdOzb"
            crossorigin="anonymous"></script>

    <script>
        $(document).ready(function () {
            $('#commentsTable').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/2.3.1/i18n/fr-FR.json'
                },
                columnDefs: [
                    { responsivePriority: 1, targets: 1 },
                    { responsivePriority: 2, targets: 4 },
                    { responsivePriority: 3, targets: 6 },
                    { orderable: false, targets: [4, 6] }
                ]
            });
        });
    </script>
{% endblock %}

{% block main %}
    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">

        {% include 'components/admin/page_header.html.twig' with {
            badge: 'Commentaires',
            title: 'Liste des commentaires',
            subtitle: 'Consultez, modérez et supprimez les commentaires publiés sur les articles du blog.'
        } %}

        {% include 'components/alert.html.twig' %}

        {% set tableContent %}
            <div class="table-responsive">
                <table id="commentsTable" class="table table-striped align-middle text-center w-100 mb-0">
                    <thead>
                        <tr>
                            <th>Id</th>
                            <th>Utilisateur</th>
                            <th>Email</th>
                            <th>Article</th>
                            <th>Statut</th>
                            <th>Contenu</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for comment in comments %}
                            <tr>
                                <td>{{ comment.id }}</td>

                                <td class="text-start">
                                    {% if comment.user %}
                                        <div class="admin-comment-user">
                                            <span class="admin-comment-user__name">
                                                {{ comment.user.firstName }} {{ comment.user.lastName }}
                                            </span>
                                            <span class="admin-comment-user__meta d-md-none">#{{ comment.id }}</span>
                                        </div>
                                    {% else %}
                                        <span class="admin-comment-missing-user">
                                            <i class="fas fa-user-slash me-1" aria-hidden="true"></i>
                                            Utilisateur supprimé
                                        </span>
                                    {% endif %}
                                </td>

                                <td class="text-start">
                                    {% if comment.user %}
                                        <span class="admin-comment-email d-inline-block text-truncate" style="max-width: 220px;"
                                              title="{{ comment.user.email }}">
                                            {{ comment.user.email }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>

                                <td class="text-start">
                                    <span class="admin-comment-post d-inline-block text-truncate" style="max-width: 260px;"
                                          title="{{ comment.post.title }}">
                                        {{ comment.post.title }}
                                    </span>
                                </td>

                                <td>
                                    <div class="admin-comment-status">
                                        {% if comment.isActivated %}
                                            <span class="badge rounded-pill admin-comment-status-badge admin-comment-status-badge--published">
                                                <i class="fa-regular fa-calendar-check me-1" aria-hidden="true"></i>
                                                Publié
                                            </span>

                                            <span class="admin-comment-status__date">
                                                {{ comment.activatedAt ? comment.activatedAt|date('d/m/Y') : '' }}
                                            </span>
                                        {% else %}
                                            <span class="badge rounded-pill admin-comment-status-badge admin-comment-status-badge--pending">
                                                <i class="fa-solid fa-circle-xmark me-1" aria-hidden="true"></i>
                                                Masqué
                                            </span>
                                        {% endif %}

                                        <form action="{{ path('app_admin_comment_activate', {'id': comment.id}) }}"
                                              method="post"
                                              class="admin-comment-switch-form">
                                            <div class="form-check form-switch d-flex justify-content-center align-items-center mb-0">
                                                <input type="hidden"
                                                       name="csrf_token"
                                                       value="{{ csrf_token('activate-comment-' ~ comment.id) }}">

                                                <input {{ comment.isActivated ? 'checked' : '' }}
                                                       onclick="return confirm('Confirmer cette action ?')"
                                                       onchange="this.form.submit()"
                                                       class="form-check-input"
                                                       type="checkbox"
                                                       aria-label="Changer le statut du commentaire {{ comment.id }}">
                                            </div>
                                        </form>
                                    </div>
                                </td>

                                <td class="text-start">
                                    <span class="admin-comment-content d-inline-block text-truncate"
                                          style="max-width: 320px;"
                                          title="{{ comment.content }}">
                                        {{ comment.content }}
                                    </span>
                                </td>

                                <td>
                                    <div class="admin-table-actions justify-content-center">
                                        <form class="d-inline"
                                              action="{{ path('app_admin_comment_delete', {'id': comment.id}) }}"
                                              method="post">
                                            <input type="hidden"
                                                   name="csrf_token"
                                                   value="{{ csrf_token('delete-comment-' ~ comment.id) }}">

                                            <button type="submit"
                                                    class="btn btn-sm admin-action-btn admin-action-btn--delete"
                                                    onclick="return confirm('Attention !!! Confirmer la suppression ?')"
                                                    aria-label="Supprimer le commentaire {{ comment.id }}">
                                                <i class="fa-solid fa-trash" aria-hidden="true"></i>
                                                <span>Supprimer</span>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        {% endset %}

        {% set emptyState %}
            <div class="admin-empty-state">
                <div class="admin-empty-state__icon">
                    <i class="fa-regular fa-comments" aria-hidden="true"></i>
                </div>

                <h3 class="admin-empty-state__title">Aucun commentaire pour le moment</h3>

                <p class="admin-empty-state__text">
                    Les commentaires publiés sur les articles apparaîtront ici pour modération.
                </p>
            </div>
        {% endset %}

        <div class="mt-4">
            {% include 'components/admin/table_card.html.twig' with {
                title: 'Commentaires publiés',
                subtitle: 'Retrouvez les auteurs, le statut de publication et le contenu des commentaires.',
                actions: null,
                table: comments|length ? tableContent : null,
                empty_state: comments|length ? null : emptyState,
                body_class: comments|length ? 'is-flush' : ''
            } %}
        </div>
    </div>
{% endblock %}