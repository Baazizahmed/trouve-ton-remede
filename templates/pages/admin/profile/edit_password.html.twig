{% extends 'themes/base_admin.html.twig' %}

{% block title %}Modifier mon mot de passe{% endblock %}
{% block description %}Modifier mon mot de passe{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Mon compte</span>
{% endblock %}

{% block main %}
<div class="container mt-4">

    {% set header_actions %}
        <a href="{{ path('app_admin_home') }}" class="btn btn-outline-secondary">
            Retour au dashboard
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Mon compte',
        title: 'Modifier mon mot de passe',
        subtitle: 'Mettez à jour votre mot de passe en toute sécurité.',
        actions: header_actions
    } %}

    {% set info_card_content %}
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

            <div class="mb-4">
                {{ form_label(form.currentPassword, 'Mot de passe actuel', {
                    label_attr: { class: 'form-label fw-semibold' }
                }) }}
                <div class="text-danger small mb-1">{{ form_errors(form.currentPassword) }}</div>
                {{ form_widget(form.currentPassword, {
                    attr: {
                        class: 'form-control',
                        autofocus: 'autofocus',
                        placeholder: 'Saisissez votre mot de passe actuel'
                    }
                }) }}
            </div>

            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.plainPassword.first, 'Nouveau mot de passe', {
                            label_attr: { class: 'form-label fw-semibold' }
                        }) }}
                        <div class="text-danger small mb-1">{{ form_errors(form.plainPassword.first) }}</div>
                        {{ form_widget(form.plainPassword.first, {
                            attr: {
                                class: 'form-control',
                                placeholder: 'Au moins 12 caractères'
                            }
                        }) }}
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.plainPassword.second, 'Confirmation du nouveau mot de passe', {
                            label_attr: { class: 'form-label fw-semibold' }
                        }) }}
                        <div class="text-danger small mb-1">{{ form_errors(form.plainPassword.second) }}</div>
                        {{ form_widget(form.plainPassword.second, {
                            attr: {
                                class: 'form-control',
                                placeholder: 'Répétez le nouveau mot de passe'
                            }
                        }) }}
                    </div>
                </div>
            </div>

            <div class="alert alert-light border mt-4 mb-0" role="alert">
                <small class="text-muted">
                    Utilisez un mot de passe long, unique et difficile à deviner.
                </small>
            </div>

            <div class="mt-4 pt-3 border-top">
                <p class="text-muted small mb-3">
                    Vérifiez les champs avant d’enregistrer votre nouveau mot de passe.
                </p>

                {% include 'components/admin/action_buttons.html.twig' with {
                    primary_label: 'Enregistrer les modifications',
                    primary_type: 'submit',
                    primary_icon: 'floppy-disk',
                    primary_class: 'btn btn-admin-primary px-4',
                    align: 'end',
                    stack_mobile: true
                } %}
            </div>

        {{ form_end(form) }}
    {% endset %}

    <div class="row justify-content-center mt-4">
        <div class="col-lg-8 col-xl-7">
            {% include 'components/admin/info_card.html.twig' with {
                title: 'Sécurité du compte',
                subtitle: 'Mettez à jour vos accès avec un mot de passe robuste et confirmé.',
                icon: 'user-lock',
                content: info_card_content
            } %}
        </div>
    </div>

</div>
{% endblock %}