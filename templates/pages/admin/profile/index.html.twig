{% extends 'themes/base_admin.html.twig' %}

{% block title %}Mon profil{% endblock %}
{% block description %}Mon profil{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Compte administrateur</span>
{% endblock %}

{% block main %}
<div class="container-fluid mt-4 admin-profile-page">

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Compte utilisateur',
        title: 'Mon profil',
        subtitle: 'Consultez et mettez à jour vos informations personnelles.'
    } %}

    {% include 'components/alert.html.twig' %}

    {% set info_card_content %}
        <div class="admin-summary-identity">
            <div class="admin-summary-avatar">
                {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
            </div>

            <div class="admin-summary-identity__content">
                <h2 class="admin-summary-identity__title">
                    {{ app.user.firstName }} {{ app.user.lastName }}
                </h2>
                <p class="admin-summary-identity__subtitle">
                    Administrateur
                </p>
            </div>
        </div>

        <div class="admin-summary-list">
            <div class="admin-summary-list__row">
                <div class="admin-summary-list__icon">
                    <i class="fa-solid fa-user"></i>
                </div>

                <div class="admin-summary-list__content">
                    <span class="admin-summary-list__label">Prénom</span>
                    <span class="admin-summary-list__value">{{ app.user.firstName }}</span>
                </div>
            </div>

            <div class="admin-summary-list__row">
                <div class="admin-summary-list__icon">
                    <i class="fa-solid fa-user-tag"></i>
                </div>

                <div class="admin-summary-list__content">
                    <span class="admin-summary-list__label">Nom</span>
                    <span class="admin-summary-list__value">{{ app.user.lastName }}</span>
                </div>
            </div>

            <div class="admin-summary-list__row">
                <div class="admin-summary-list__icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div class="admin-summary-list__content">
                    <span class="admin-summary-list__label">Adresse email</span>
                    <span class="admin-summary-list__value text-break">
                        {{ app.user.email }}
                    </span>
                </div>
            </div>
        </div>
    {% endset %}

    {% set info_card_footer %}
        {% include 'components/admin/action_buttons.html.twig' with {
            secondary_label: 'Modifier mon profil',
            secondary_href: path('app_admin_profile_edit_profile'),
            secondary_icon: 'user-pen',
            primary_label: 'Modifier mon mot de passe',
            primary_href: path('app_admin_profile_edit_password'),
            primary_icon: 'lock',
            align: 'end',
            stack_mobile: true
        } %}
    {% endset %}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% include 'components/admin/info_card.html.twig' with {
                title: 'Informations du compte',
                subtitle: 'Résumé de votre profil administrateur',
                icon: 'user-shield',
                content: info_card_content,
                footer: info_card_footer
            } %}
        </div>
    </div>

</div>
{% endblock %}