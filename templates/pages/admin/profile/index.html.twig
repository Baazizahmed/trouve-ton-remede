{% extends 'themes/base_admin.html.twig' %}

{% block title %}Mon profil{% endblock %}
{% block description %}Mon profil{% endblock %}

{% block main %}
<div class="container-fluid mt-4 admin-profile-page">

    <div class="admin-page-header mb-4">
        <div>
            <span class="admin-page-header__badge">
                Compte utilisateur
            </span>

            <h1 class="admin-page-header__title">
                Mon profil
            </h1>

            <p class="admin-page-header__subtitle">
                Consultez et mettez à jour vos informations personnelles.
            </p>
        </div>
    </div>

    {% include 'components/alert.html.twig' %}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm admin-profile-card">
                <div class="card-body">

                    <div class="admin-profile-card__header">
                        <div class="admin-profile-card__avatar">
                            {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
                        </div>

                        <div>
                            <h2 class="admin-profile-card__name">
                                {{ app.user.firstName }} {{ app.user.lastName }}
                            </h2>

                            <p class="admin-profile-card__role mb-0">
                                Administrateur
                            </p>
                        </div>
                    </div>

                    <div class="admin-profile-card__infos">

                        <div class="admin-profile-card__row">
                            <div class="admin-profile-card__icon">
                                <i class="fa-solid fa-user"></i>
                            </div>

                            <div class="admin-profile-card__content">
                                <span class="admin-profile-card__label">Prénom</span>
                                <span class="admin-profile-card__value">{{ app.user.firstName }}</span>
                            </div>
                        </div>

                        <div class="admin-profile-card__row">
                            <div class="admin-profile-card__icon">
                                <i class="fa-solid fa-user-tag"></i>
                            </div>

                            <div class="admin-profile-card__content">
                                <span class="admin-profile-card__label">Nom</span>
                                <span class="admin-profile-card__value">{{ app.user.lastName }}</span>
                            </div>
                        </div>

                        <div class="admin-profile-card__row">
                            <div class="admin-profile-card__icon">
                                <i class="fa-solid fa-envelope"></i>
                            </div>

                            <div class="admin-profile-card__content">
                                <span class="admin-profile-card__label">Adresse email</span>
                                <span class="admin-profile-card__value text-break">{{ app.user.email }}</span>
                            </div>
                        </div>

                    </div>

                    <div class="admin-profile-card__actions">
                        <a href="{{ path('app_admin_profile_edit_profile') }}"
                           class="btn btn-outline-primary admin-profile-btn">
                            <i class="fa-solid fa-user-pen me-2"></i>
                            Modifier mon profil
                        </a>

                        <a href="{{ path('app_admin_profile_edit_password') }}"
                           class="btn btn-primary admin-profile-btn">
                            <i class="fa-solid fa-lock me-2"></i>
                            Modifier mon mot de passe
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}