{% extends 'themes/base_admin.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}
{% block description %}Modifier mon profil{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Mon compte</span>
{% endblock %}

{% block main %}
<div class="container mt-4">

    {% set header_actions %}
        <a href="{{ path('app_admin_home') }}" class="btn btn-outline-secondary">
            Retour au dashboard
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Mon compte',
        title: 'Modifier mon profil',
        subtitle: 'Mettez à jour vos informations personnelles.',
        actions: header_actions
    } %}

    {% set info_card_content %}
        {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}

            <div class="row g-4">
                <div class="col-12 col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.firstName, 'Prénom', {
                            label_attr: { class: 'form-label fw-semibold' }
                        }) }}
                        <div class="text-danger small mb-1">{{ form_errors(form.firstName) }}</div>
                        {{ form_widget(form.firstName, {
                            attr: {
                                class: 'form-control',
                                autofocus: 'autofocus',
                                placeholder: 'Votre prénom'
                            }
                        }) }}
                    </div>
                </div>

                <div class="col-12 col-md-6">
                    <div class="mb-3">
                        {{ form_label(form.lastName, 'Nom', {
                            label_attr: { class: 'form-label fw-semibold' }
                        }) }}
                        <div class="text-danger small mb-1">{{ form_errors(form.lastName) }}</div>
                        {{ form_widget(form.lastName, {
                            attr: {
                                class: 'form-control',
                                placeholder: 'Votre nom'
                            }
                        }) }}
                    </div>
                </div>

                <div class="col-12">
                    <div class="mb-3">
                        {{ form_label(form.email, 'Email', {
                            label_attr: { class: 'form-label fw-semibold' }
                        }) }}
                        <div class="text-danger small mb-1">{{ form_errors(form.email) }}</div>
                        {{ form_widget(form.email, {
                            attr: {
                                class: 'form-control',
                                placeholder: 'Votre adresse email'
                            }
                        }) }}
                        <div class="form-text">
                            Utilisez une adresse email valide et régulièrement consultée.
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-4 pt-3 border-top">
                <p class="text-muted small mb-3">
                    Vérifiez vos informations avant d’enregistrer.
                </p>

                {% include 'components/admin/action_buttons.html.twig' with {
                    primary_label: 'Enregistrer les modifications',
                    primary_type: 'submit',
                    primary_icon: 'floppy-disk',
                    primary_class: 'btn btn-admin-primary px-4',
                    align: 'end',
                    stack_mobile: true
                } %}
            </div>

        {{ form_end(form) }}
    {% endset %}

    <div class="row justify-content-center mt-4">
        <div class="col-lg-8">
            {% include 'components/admin/info_card.html.twig' with {
                title: 'Informations personnelles',
                subtitle: 'Mettez à jour vos coordonnées et informations de compte.',
                icon: 'circle-user',
                content: info_card_content
            } %}
        </div>
    </div>

</div>
{% endblock %}