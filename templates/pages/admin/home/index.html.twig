{% extends 'themes/base_admin.html.twig' %}

{% block title %}Dashboard admin{% endblock %}
{% block description %}Dashboard administrateur{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Vue d’ensemble</span>
{% endblock %}

{% block main %}
    {% set currentHour = "now"|date('H') %}

    <div class="container-fluid px-2 px-md-3 mt-4 admin-dashboard">

        {% include 'components/admin/page_header.html.twig' with {
            badge: 'Administration',
            title: currentHour < 18
                ? 'Bonne journée ' ~ app.user.firstName
                : 'Bonne soirée ' ~ app.user.firstName,
            subtitle: 'Gérez le blog, la boutique et les commandes de TrouveTonRemede depuis votre tableau de bord.'
        } %}

        {# AJOUT : accès rapide mis en avant vers le listing produit pour la gestion stock #}
        <section class="mb-4">
            <div class="alert alert-light border d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                <div>
                    <strong>Stock produits :</strong> accédez rapidement au catalogue pour ajuster les quantités et repérer les ruptures.
                </div>
                <div>
                    <a href="{{ path('app_admin_product_index') }}" class="btn btn-sm btn-primary">
                        <i class="fa-solid fa-boxes-stacked me-2"></i>
                        Ouvrir le catalogue produits
                    </a>
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h5 text-muted mb-3">
                <i class="fa-solid fa-blog me-2"></i>
                Vue d’ensemble du blog
            </h2>

            <div class="row g-3">
                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-newspaper',
                        label: 'Articles',
                        value: posts_count,
                        variant: 'primary',
                        description: 'Tous les articles du blog',
                        href: path('app_admin_post_index')
                    } only %}
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-folder-open',
                        label: 'Catégories',
                        value: categories_count,
                        variant: 'success',
                        description: 'Organisation du blog',
                        href: path('app_admin_category_index')
                    } only %}
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-comments',
                        label: 'Commentaires',
                        value: comments_count,
                        variant: 'warning',
                        description: 'Messages reçus',
                        href: path('app_admin_comment_index')
                    } only %}
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-users',
                        label: 'Utilisateurs',
                        value: users_count,
                        variant: 'info',
                        description: 'Comptes enregistrés',
                        href: path('app_admin_user_index')
                    } only %}
                </div>
            </div>
        </section>

        <section class="mb-5">
            <h2 class="h5 text-muted mb-3">
                <i class="fa-solid fa-store me-2"></i>
                Vue d’ensemble de la boutique
            </h2>

            <div class="row g-3">
                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-leaf',
                        label: 'Produits',
                        value: products_count,
                        variant: 'success',
                        description: 'Produits au catalogue',
                        href: path('app_admin_product_index')
                    } only %}
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-basket-shopping',
                        label: 'Commandes',
                        value: orders_count,
                        variant: 'info',
                        description: 'Toutes les commandes',
                        href: path('app_admin_order_index')
                    } only %}
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-clock',
                        label: 'En attente',
                        value: pending_orders_count,
                        variant: 'warning',
                        description: 'À traiter',
                        href: path('app_admin_order_index')
                    } only %}
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    {% include 'components/admin/stat_card.html.twig' with {
                        icon: 'fa-solid fa-credit-card',
                        label: 'Payées',
                        value: paid_orders_count,
                        variant: 'primary',
                        description: 'Commandes payées',
                        href: path('app_admin_order_index')
                    } only %}
                </div>
            </div>
        </section>

        <section>
            <h2 class="h5 text-muted mb-3">
                <i class="fa-solid fa-bolt me-2"></i>
                Actions rapides
            </h2>

            <div class="row g-3">
                <div class="col-12 col-md-6">
                    <a href="{{ path('app_admin_product_index') }}" class="admin-quick-action-card">
                        <span class="admin-quick-action-card__icon">
                            <i class="fa-solid fa-leaf"></i>
                        </span>

                        <span class="admin-quick-action-card__content">
                            <span class="admin-quick-action-card__title">Gérer les produits</span>
                            <span class="admin-quick-action-card__text">
                                Accéder au catalogue et aux fiches produits.
                            </span>
                        </span>

                        <span class="admin-quick-action-card__arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </a>
                </div>

                <div class="col-12 col-md-6">
                    <a href="{{ path('app_admin_order_index') }}" class="admin-quick-action-card">
                        <span class="admin-quick-action-card__icon">
                            <i class="fa-solid fa-basket-shopping"></i>
                        </span>

                        <span class="admin-quick-action-card__content">
                            <span class="admin-quick-action-card__title">Gérer les commandes</span>
                            <span class="admin-quick-action-card__text">
                                Voir les commandes en attente et les commandes payées.
                            </span>
                        </span>

                        <span class="admin-quick-action-card__arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </span>
                    </a>
                </div>
            </div>
        </section>
    </div>
{% endblock %}