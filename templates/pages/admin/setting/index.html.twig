{% extends 'themes/base_admin.html.twig' %}

{% block title %}Les paramètres du site{% endblock %}
{% block description %}Les paramètres du site{% endblock %}

{% block admin_topbar_context %}
    <span class="admin-topbar__context">Configuration générale</span>
{% endblock %}

{% block main %}
<div class="container-fluid mt-4 admin-profile-page">

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Configuration du site',
        title: 'Paramètres du site',
        subtitle: 'Consultez et mettez à jour les informations générales du site.'
    } %}

    {% include 'components/alert.html.twig' %}

    {% set info_card_content %}
        <div class="admin-summary-list">
            <div class="admin-summary-list__row">
                <div class="admin-summary-list__icon">
                    <i class="fa-solid fa-envelope"></i>
                </div>

                <div class="admin-summary-list__content">
                    <span class="admin-summary-list__label">Adresse email</span>
                    <span class="admin-summary-list__value text-break">
                        {{ setting.email ?: 'Non renseigné' }}
                    </span>
                </div>
            </div>

            <div class="admin-summary-list__row">
                <div class="admin-summary-list__icon">
                    <i class="fa-solid fa-phone"></i>
                </div>

                <div class="admin-summary-list__content">
                    <span class="admin-summary-list__label">Téléphone</span>
                    <span class="admin-summary-list__value">
                        {{ setting.phone ?: 'Non renseigné' }}
                    </span>
                </div>
            </div>
        </div>
    {% endset %}

    {% set info_card_footer %}
        {% include 'components/admin/action_buttons.html.twig' with {
            primary_label: 'Modifier les paramètres',
            primary_href: path('app_admin_setting_edit', {'id': setting.id}),
            primary_icon: 'pen-to-square',
            align: 'end',
            stack_mobile: true
        } %}
    {% endset %}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            {% include 'components/admin/info_card.html.twig' with {
                title: 'Paramètres du site',
                subtitle: 'Configuration générale',
                icon: 'gear',
                content: info_card_content,
                footer: info_card_footer
            } %}
        </div>
    </div>

</div>
{% endblock %}