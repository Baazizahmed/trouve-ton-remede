{% extends 'themes/base_admin.html.twig' %}

{% block title %}Les paramètres du site{% endblock %}
{% block description %}Les paramètres du site{% endblock %}

{% block main %}
<div class="container-fluid mt-4 admin-profile-page">

    <div class="admin-page-header mb-4">
        <div>
            <span class="admin-page-header__badge">
                Configuration du site
            </span>

            <h1 class="admin-page-header__title">
                Paramètres du site
            </h1>

            <p class="admin-page-header__subtitle">
                Consultez et mettez à jour les informations générales du site.
            </p>
        </div>
    </div>

    {% include 'components/alert.html.twig' %}

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm admin-profile-card">
                <div class="card-body">

                    <div class="admin-profile-card__header">
                        <div class="admin-profile-card__avatar">
                            <i class="fa-solid fa-gear"></i>
                        </div>

                        <div>
                            <h2 class="admin-profile-card__name">
                                Paramètres du site
                            </h2>

                            <p class="admin-profile-card__role mb-0">
                                Configuration générale
                            </p>
                        </div>
                    </div>

                    <div class="admin-profile-card__infos">
                        <div class="admin-profile-card__row">
                            <div class="admin-profile-card__icon">
                                <i class="fa-solid fa-envelope"></i>
                            </div>

                            <div class="admin-profile-card__content">
                                <span class="admin-profile-card__label">Adresse email</span>
                                <span class="admin-profile-card__value text-break">
                                    {{ setting.email ?: 'Non renseigné' }}
                                </span>
                            </div>
                        </div>

                        <div class="admin-profile-card__row">
                            <div class="admin-profile-card__icon">
                                <i class="fa-solid fa-phone"></i>
                            </div>

                            <div class="admin-profile-card__content">
                                <span class="admin-profile-card__label">Téléphone</span>
                                <span class="admin-profile-card__value">
                                    {{ setting.phone ?: 'Non renseigné' }}
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="admin-profile-card__actions">
                        <a href="{{ path('app_admin_setting_edit', {'id': setting.id}) }}"
                           class="btn btn-outline-primary admin-profile-btn">
                            <i class="fa-solid fa-pen-to-square me-2"></i>
                            Modifier les paramètres
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}