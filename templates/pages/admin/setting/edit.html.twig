{% extends 'themes/base_admin.html.twig' %}

{% block title %}Modifier les paramètres du site{% endblock %}

{% block description %}Modifier les paramètres du site{% endblock %}

{% block main %}
<div class="container mt-4">

    {% set header_actions %}
        <a href="{{ path('app_admin_setting_index') }}" class="btn btn-outline-secondary">
            Retour aux paramètres
        </a>
    {% endset %}

    {% include 'components/admin/page_header.html.twig' with {
        badge: 'Administration',
        title: 'Modifier les paramètres du site',
        subtitle: 'Mettez à jour les informations principales visibles sur la boutique et les pages de contact.',
        actions: header_actions
    } %}

    <div class="card border-0 shadow-sm mt-4">
        <div class="card-body p-4 p-lg-5">
            <div class="row align-items-start g-4">
                <div class="col-lg-4">
                    <div class="pe-lg-4">
                        <h2 class="h4 mb-3">Informations générales</h2>
                        <p class="text-muted mb-0">
                            Modifiez ici les coordonnées principales du site. Ces informations peuvent être réutilisées dans les pages de contact et les éléments de confiance.
                        </p>
                    </div>
                </div>

                <div class="col-lg-8">
                    {{ form_start(form) }}

                        <div class="row g-4">
                            <div class="col-12">
                                {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <div class="text-danger small mb-1">{{ form_errors(form.email) }}</div>
                                {{ form_widget(form.email, {
                                    attr: {
                                        class: 'form-control',
                                        autofocus: 'autofocus',
                                        placeholder: 'exemple@email.com'
                                    }
                                }) }}
                            </div>

                            <div class="col-12">
                                {{ form_label(form.phone, 'Numéro de téléphone', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                                <div class="text-danger small mb-1">{{ form_errors(form.phone) }}</div>
                                {{ form_widget(form.phone, {
                                    attr: {
                                        class: 'form-control',
                                        placeholder: '07 00 00 00 00'
                                    }
                                }) }}
                            </div>
                        </div>

                        <div class="d-flex flex-column flex-sm-row justify-content-end align-items-sm-center gap-3 mt-4 pt-3 border-top">
                            <span class="text-muted small">
                                Vérifiez bien les coordonnées avant enregistrement.
                            </span>

                            <button formnovalidate type="submit" class="btn btn-primary px-4">
                                Enregistrer les modifications
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}