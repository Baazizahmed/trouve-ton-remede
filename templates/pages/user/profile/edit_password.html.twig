{% extends 'themes/base_user.html.twig' %}

{% block title %}Modifier mon mot de passe{% endblock %}
{% block description %}Mettez à jour le mot de passe de votre compte.{% endblock %}

{% block main %}
<div class="container my-5 user-password-edit-page">

    {% set headerActions %}
        <a href="{{ path('app_user_profile_index') }}" class="btn btn-outline-primary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Retour au profil
        </a>
    {% endset %}

    {% include 'components/user/page_header.html.twig' with {
        eyebrow: 'Espace utilisateur',
        title: 'Modifier mon mot de passe',
        subtitle: 'Choisissez un nouveau mot de passe sécurisé pour protéger votre compte.',
        icon: 'fa-solid fa-lock',
        centered: true,
        actions: headerActions
    } %}

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 user-profile-form-card">
                <div class="card-body">
                    {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_label(form.currentPassword, 'Mot de passe actuel') }}
                            <div class="text-danger small mb-1">{{ form_errors(form.currentPassword) }}</div>
                            {{ form_widget(form.currentPassword, {
                                attr: {
                                    class: 'form-control',
                                    autofocus: 'autofocus'
                                }
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.plainPassword.first, 'Nouveau mot de passe') }}
                            <div class="text-danger small mb-1">{{ form_errors(form.plainPassword.first) }}</div>
                            {{ form_widget(form.plainPassword.first, {
                                attr: {
                                    class: 'form-control',
                                    placeholder: 'Au moins 12 caractères'
                                }
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.plainPassword.second, 'Confirmation du nouveau mot de passe') }}
                            <div class="text-danger small mb-1">{{ form_errors(form.plainPassword.second) }}</div>
                            {{ form_widget(form.plainPassword.second, {
                                attr: {
                                    class: 'form-control'
                                }
                            }) }}
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="{{ path('app_user_profile_index') }}" class="btn btn-outline-secondary">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Mettre à jour le mot de passe
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}