{% extends 'themes/base_user.html.twig' %}

{% block title %}Mon profil{% endblock %}
{% block description %}Consultez vos informations personnelles et gérez votre compte.{% endblock %}

{% block main %}
<div class="container my-5 user-profile-page">

    {% set headerActions %}
        <a href="{{ path('app_user_profile_edit_profile') }}" class="btn btn-outline-primary">
            <i class="fa-solid fa-pen me-2"></i>
            Modifier mon profil
        </a>
    {% endset %}

    {% include 'components/user/page_header.html.twig' with {
        eyebrow: 'Espace utilisateur',
        title: 'Mon profil',
        subtitle: 'Retrouvez vos informations personnelles et les actions utiles pour gérer votre compte.',
        icon: 'fa-solid fa-user',
        centered: true,
        actions: headerActions
    } %}

    {% include 'components/alert.html.twig' %}

    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 user-profile-card">
                <div class="card-body">
                    <h2 class="h4 mb-4">Informations personnelles</h2>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="user-profile-info">
                                <span class="text-muted d-block mb-1">Prénom</span>
                                <strong>{{ app.user.firstName }}</strong>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="user-profile-info">
                                <span class="text-muted d-block mb-1">Nom</span>
                                <strong>{{ app.user.lastName }}</strong>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="user-profile-info">
                                <span class="text-muted d-block mb-1">Adresse email</span>
                                <strong>{{ app.user.email }}</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card border-0 user-profile-card">
                <div class="card-body">
                    <h2 class="h4 mb-3">Actions du compte</h2>
                    <p class="text-muted mb-4">
                        Mettez à jour vos informations personnelles ou modifiez votre mot de passe.
                    </p>

                    <div class="d-grid gap-2">
                        <a href="{{ path('app_user_profile_edit_profile') }}" class="btn btn-primary">
                            Modifier mon profil
                        </a>
                        <a href="{{ path('app_user_profile_edit_password') }}" class="btn btn-outline-secondary">
                            Modifier mon mot de passe
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}