{% extends 'themes/base_user.html.twig' %}

{% block title %}Modifier mon profil{% endblock %}
{% block description %}Mettez à jour vos informations personnelles.{% endblock %}

{% block main %}
<div class="container my-5 user-profile-edit-page">

    {% set headerActions %}
        <a href="{{ path('app_user_profile_index') }}" class="btn btn-outline-primary">
            <i class="fa-solid fa-arrow-left me-2"></i>
            Retour au profil
        </a>
    {% endset %}

    {% include 'components/user/page_header.html.twig' with {
        eyebrow: 'Espace utilisateur',
        title: 'Modifier mon profil',
        subtitle: 'Mettez à jour vos informations personnelles depuis votre espace utilisateur.',
        icon: 'fa-solid fa-user-pen',
        centered: true,
        actions: headerActions
    } %}

    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 user-profile-form-card">
                <div class="card-body">
                    {{ form_start(form) }}

                        <div class="mb-3">
                            {{ form_label(form.firstName, 'Prénom') }}
                            <div class="text-danger small mb-1">{{ form_errors(form.firstName) }}</div>
                            {{ form_widget(form.firstName, {
                                attr: {
                                    class: 'form-control',
                                    autofocus: 'autofocus'
                                }
                            }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.lastName, 'Nom') }}
                            <div class="text-danger small mb-1">{{ form_errors(form.lastName) }}</div>
                            {{ form_widget(form.lastName, {
                                attr: {
                                    class: 'form-control'
                                }
                            }) }}
                        </div>

                        <div class="mb-4">
                            {{ form_label(form.email, 'Adresse email') }}
                            <div class="text-danger small mb-1">{{ form_errors(form.email) }}</div>
                            {{ form_widget(form.email, {
                                attr: {
                                    class: 'form-control'
                                }
                            }) }}
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <a href="{{ path('app_user_profile_index') }}" class="btn btn-outline-secondary">
                                Annuler
                            </a>
                            <button type="submit" class="btn btn-primary">
                                Enregistrer les modifications
                            </button>
                        </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>

</div>
{% endblock %}