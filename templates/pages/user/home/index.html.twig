{% extends 'themes/base_user.html.twig' %}

{% block title %}Dashboard utilisateur{% endblock %}
{% block description %}Accueil{% endblock %}

{% block main %}
<div class="container my-5 user-dashboard">

    {% set currentHour = "now"|date('H') %}
    {% set cartCount = cartCounter.getItemCount() %}

    {% set dashboardTitle %}
        {% if currentHour < 18 %}
            Bonne journée {{ app.user.firstName }}
        {% else %}
            Bonne soirée {{ app.user.firstName }}
        {% endif %}
    {% endset %}

    {% set headerActions %}
        <a href="{{ path('app_order_index') }}" class="btn btn-outline-primary">
            <i class="fa-solid fa-box me-2"></i>
            Mes commandes
        </a>
    {% endset %}

    {% include 'components/user/page_header.html.twig' with {
        eyebrow: 'Espace utilisateur',
        title: dashboardTitle|trim,
        subtitle: 'Retrouvez ici vos activités, vos dernières commandes et vos raccourcis utiles pour gérer votre compte.',
        icon: 'fa-solid fa-leaf',
        centered: true,
        actions: headerActions
    } %}

    {% if cartCount > 0 %}
        <div class="alert alert-success mb-4 text-center">
            Vous avez <strong>{{ cartCount }}</strong> article{{ cartCount > 1 ? 's' : '' }} dans votre panier.
            <a href="{{ path('app_cart_index') }}" class="alert-link ms-1">
                Voir mon panier
            </a>
        </div>
    {% else %}
        <div class="alert alert-info mb-4 text-center">
            Votre panier est vide pour le moment.
            <a href="{{ path('app_visitor_product_index') }}" class="alert-link ms-1">
                Découvrir les produits
            </a>
        </div>
    {% endif %}

    <div class="row mb-5 g-4 user-dashboard-stats">
        <div class="col-md-6">
            {% include 'components/user/stat_card.html.twig' with {
                label: 'Commentaires publiés',
                value: app.user.comments|length,
                icon: 'fa-solid fa-comments',
                icon_variant: 'primary'
            } %}
        </div>

        <div class="col-md-6">
            {% include 'components/user/stat_card.html.twig' with {
                label: 'Articles likés',
                value: app.user.likes|length,
                icon: 'fa-solid fa-heart',
                icon_variant: 'danger'
            } %}
        </div>
    </div>

    <div class="row mb-5 g-4 user-dashboard-shortcuts">
        <div class="col-md-4">
            {% include 'components/user/quick_action_card.html.twig' with {
                title: 'Mon panier',
                text: 'Consultez les plantes médicinales que vous avez ajoutées.',
                href: path('app_cart_index'),
                action_label: 'Voir mon panier',
                icon: 'fa-solid fa-basket-shopping',
                variant: 'success',
                button_style: 'solid'
            } %}
        </div>

        <div class="col-md-4">
            {% include 'components/user/quick_action_card.html.twig' with {
                title: 'Mes commandes',
                text: 'Consultez l’historique de vos commandes.',
                href: path('app_order_index'),
                action_label: 'Voir mes commandes',
                icon: 'fa-solid fa-box',
                variant: 'primary',
                button_style: 'solid'
            } %}
        </div>

        <div class="col-md-4">
            {% include 'components/user/quick_action_card.html.twig' with {
                title: 'Mon profil',
                text: 'Modifier mes informations personnelles.',
                href: path('app_user_profile_index'),
                action_label: 'Gérer mon profil',
                icon: 'fa-solid fa-user',
                variant: 'info',
                button_style: 'outline'
            } %}
        </div>
    </div>

    <div class="card border-0 user-dashboard-orders">
        <div class="card-body">
            <h4 class="mb-4">
                <i class="fa-solid fa-clock-rotate-left me-2"></i>
                Mes dernières commandes
            </h4>

            {% if last_orders is not empty %}
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Référence</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th>Total TTC</th>
                                <th></th>
                            </tr>
                        </thead>

                        <tbody>
                        {% for order in last_orders %}
                            <tr>
                                <td class="fw-semibold">#{{ order.id }}</td>
                                <td>{{ order.createdAt|date('d/m/Y') }}</td>
                                <td>
                                    {% if order.status == 'paid' %}
                                        <span class="badge bg-success">Payée</span>
                                    {% elseif order.status == 'pending' %}
                                        <span class="badge bg-warning text-dark">En attente</span>
                                    {% else %}
                                        <span class="badge bg-secondary">
                                            {{ order.status|capitalize }}
                                        </span>
                                    {% endif %}
                                </td>
                                <td class="fw-bold text-success">
                                    {{ order.totalTtc|number_format(2, ',', ' ') }} €
                                </td>
                                <td class="text-end">
                                    <a href="{{ path('app_order_show', { id: order.id }) }}"
                                       class="btn btn-sm btn-outline-primary">
                                        Détails
                                    </a>
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="user-dashboard-orders__empty text-center py-5">
                    <div class="user-dashboard-orders__empty-icon mb-3">
                        <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                    </div>

                    <h5 class="user-dashboard-orders__empty-title mb-2">
                        Aucune commande pour le moment
                    </h5>

                    <p class="user-dashboard-orders__empty-text mb-4">
                        Explorez la boutique et retrouvez ici vos prochaines commandes.
                    </p>

                    <a href="{{ path('app_visitor_product_index') }}" class="btn btn-outline-primary">
                        Découvrir les produits
                    </a>
                </div>
            {% endif %}
        </div>
    </div>

</div>
{% endblock %}