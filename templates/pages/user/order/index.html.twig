{% extends 'themes/base_user.html.twig' %}

{% block title %}Mes commandes{% endblock %}
{% block description %}Consultez l’historique de vos commandes de plantes médicinales.{% endblock %}

{% block main %}
<div class="container my-5 user-orders-page">

    {% set headerActions %}
        <a href="{{ path('app_visitor_product_index') }}" class="btn btn-outline-primary">
            <i class="fa-solid fa-leaf me-2"></i>
            Continuer mes achats
        </a>
    {% endset %}

    {% include 'components/user/page_header.html.twig' with {
        eyebrow: 'Espace utilisateur',
        title: 'Mes commandes',
        subtitle: 'Retrouvez l’historique de vos achats et consultez le détail de chaque commande.',
        icon: 'fa-solid fa-box',
        centered: true,
        actions: headerActions
    } %}

    {% if orders is empty %}
        <div class="card border-0 user-orders-empty">
            <div class="card-body text-center py-5">
                <div class="user-orders-empty__icon mb-3">
                    <i class="fa-solid fa-box-open" aria-hidden="true"></i>
                </div>

                <h2 class="h4 mb-3">Vous n’avez pas encore passé de commande</h2>

                <p class="text-muted mb-4 mx-auto" style="max-width: 36rem;">
                    Découvrez nos plantes médicinales et retrouvez ici l’historique de vos prochaines commandes.
                </p>

                <a href="{{ path('app_visitor_product_index') }}" class="btn btn-primary">
                    Découvrir les produits
                </a>
            </div>
        </div>
    {% else %}
        <div class="card border-0 user-orders-card">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                    <div>
                        <h2 class="h4 mb-1">Historique de commandes</h2>
                        <p class="text-muted mb-0">
                            {{ orders|length }} commande{{ orders|length > 1 ? 's' : '' }} enregistrée{{ orders|length > 1 ? 's' : '' }} sur votre compte.
                        </p>
                    </div>

                    <a href="{{ path('app_visitor_product_index') }}" class="btn btn-outline-primary">
                        Commander à nouveau
                    </a>
                </div>

                <div class="table-responsive">
                    <table class="table align-middle mb-0 user-orders-table">
                        <thead class="table-light">
                            <tr>
                                <th>Référence</th>
                                <th>Date</th>
                                <th>Statut</th>
                                <th>Total TTC</th>
                                <th class="text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for order in orders %}
                                <tr>
                                    <td class="fw-semibold">#{{ order.id }}</td>
                                    <td>{{ order.createdAt|date('d/m/Y à H:i') }}</td>
                                    <td>
                                        {% if order.status in ['paid', 'PAID'] %}
                                            <span class="badge bg-success">Payée</span>
                                        {% elseif order.status in ['pending', 'PENDING'] %}
                                            <span class="badge bg-warning text-dark">En attente</span>
                                        {% elseif order.status in ['cancelled', 'CANCELLED'] %}
                                            <span class="badge bg-danger">Annulée</span>
                                        {% else %}
                                            <span class="badge bg-secondary">
                                                {{ order.status|replace({'_': ' '})|lower|capitalize }}
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td class="fw-bold text-success">
                                        {{ order.totalTtc|number_format(2, ',', ' ') }} €
                                    </td>
                                    <td class="text-end">
                                        <a href="{{ path('app_order_show', { id: order.id }) }}"
                                           class="btn btn-sm btn-outline-primary">
                                            Détails
                                        </a>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

            </div>
        </div>
    {% endif %}

</div>
{% endblock %}